{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guilded-wow",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "previews": {},
  "routes": [
    { "pattern": "kcaron.top", "custom_domain": true },
    { "pattern": "www.kcaron.top", "custom_domain": true },
    { "pattern": "guilded.kcaron.top", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/robots.txt", "/sitemap.xml", "/googlefc463a9e1454c920.html", "/support", "/support/", "/companion", "/companion/*", "/api/*", "/health", "/g/*", "/quebec-gold/cores", "/quebec-gold/cores/", "/quebec-gold/wow", "/quebec-gold/wow/"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
