# /etc/guilded-backup.env on the bot server (root:guilded, mode 640). Template only: the owner fills in the real values.
# DATABASE_URL, DISCORD_TOKEN and ERROR_LOG_CHANNEL_ID come from /opt/guilded/.env.local, nothing to repeat here.
BACKUP_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=guilded-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Public keys only (made with: node scripts/offsite-backup.mjs keygen <folder on your PC>).
BACKUP_RECOVERY_PUBLIC_KEY_FILE=/etc/guilded-backup/recovery.public.pem
BACKUP_RESTORE_TEST_PUBLIC_KEY_FILE=/etc/guilded-backup/restore-test.public.pem
# Optional: lets the monthly test restore on the server (see docs/OFFSITE_BACKUPS.md, "The restore-test key").
BACKUP_RESTORE_TEST_PRIVATE_KEY_FILE=/etc/guilded-backup/restore-test.private.pem
# Optional: a Postgres URL allowed to CREATE DATABASE. Default: DATABASE_URL on the "postgres" database.
# RESTORE_TEST_ADMIN_URL=
# Optional: where temporary files go (needs room for one dump and its encrypted copy).
# BACKUP_WORKDIR=/var/tmp
