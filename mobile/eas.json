{
  "cli": {
    "version": ">= 27.4.1",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "device": {
      "extends": "preview",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "store": {
      "extends": "production"
    }
  }
}
