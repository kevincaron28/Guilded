{
  "name": "guilded-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android:preview": "eas build --platform android --profile preview",
    "config:check": "expo config --type public",
    "build:android:store": "eas build --platform android --profile production",
    "build:ios:simulator": "eas build --platform ios --profile preview",
    "build:ios:device": "eas build --platform ios --profile device",
    "build:ios:store": "eas build --platform ios --profile production",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
