NODE_ENV=development
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quebec_gold?schema=public
COMPANION_API_PORT=8787
# 127.0.0.1 = this computer only (also right behind Caddy on a server, see docs/DEPLOY_ORACLE.md)
COMPANION_API_HOST=127.0.0.1
COMPANION_UPLOAD_TOKEN=replace-with-a-random-32-character-token
# Optional: Warcraft Logs API client (https://www.warcraftlogs.com/api/clients) for /wcl
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
LOG_LEVEL=info
# Optional: a channel ID (in any guild the bot is in) that gets a live feed of
# captured errors and /report bug submissions. Leave blank to only save them
# to the database.
ERROR_LOG_CHANNEL_ID=
