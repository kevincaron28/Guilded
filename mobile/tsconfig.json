{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext"
  },
  "extends": "expo/tsconfig.base",
  "exclude": ["node_modules", "scripts", "android", "ios", "babel.config.js", "metro.config.js", "jest.config.js", "**/*.test.ts"]
}
