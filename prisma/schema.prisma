model AiDailyUsage {
  day      String
  scope    String
  attempts Int    @default(0)

  @@id([day, scope])
}

// Generated TypeScript, gitignored: `npm install` and `npm run db:update` regenerate it.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  TRIAL
  LEFT
}

enum DkpTransactionType {
  AWARD
  DEDUCTION
  ADJUSTMENT
  REFUND
  DECAY
  IMPORT
}

enum EpgpTransactionType {
  EP_AWARD
  GP_AWARD
  ITEM_AWARD
  DEDUCTION
  ADJUSTMENT
  DECAY
  IMPORT
  REVERSAL
}

enum ReadinessStatus {
  READY
  PARTIAL
  NOT_READY
  UNKNOWN
}

enum ReadinessFindingSeverity {
  INFO
  WARNING
  ERROR
}

enum AuditAction {
  MEMBER_CREATED
  MEMBER_UPDATED
  DKP_TRANSACTION_CREATED
  DKP_TRANSACTION_REVERSED
  EPGP_TRANSACTION_CREATED
  READINESS_SNAPSHOT_RECORDED
  IMPORT_PREVIEWED
  IMPORT_APPLIED
  CONFIG_UPDATED
  MODERATION_WARN
  MODERATION_TIMEOUT
  MODERATION_KICK
  MODERATION_BAN
  DUNGEON_ADMIN
  RAID_OFFICER
  CORE_OFFICER
}

enum RaidStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RaidSignupStatus {
  SIGNED_UP
  CANCELLED
  MAYBE
  WAITLISTED
}

enum RaidRole {
  TANK
  HEALER
  DPS
}

enum RaidAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  // On the bench by the raid leader's choice: full attendance credit and the
  // attendance EP, but not the per-boss or full-clear EP.
  BENCHED
}

enum RaidBossStatus {
  PENDING
  KILLED
}

enum AuctionStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  TRIAL
}

model Guild {
  mapSightings GuildMapSighting[]
  helpCalls GuildHelpCall[]
  statSnapshots GuildStatSnapshot[]
  dungeonHighlights DungeonHighlight[]
  levelRace LevelRaceEntry[]
  raceHall RaceHallEntry[]
  rankRoles GuildRankRole[]
  memberNicknames MemberNickname[]
  pugBoard PugBoardGuild?
  pugBlocks PugBlock[]
  pugRequests PugRequest[]
  memberAchievements MemberAchievement[]
  memberActivityTotals MemberActivityTotal[]
  poeLevelsReached PoeLevelReached[]
  battlegroundReports BattlegroundReport[]
  battlegroundConsents BattlegroundConsent[]
  duelResults DuelResult[]
  memberMilestones MemberMilestone[]
  recurringRecaps RecurringRecap[]
  cooperativeGoal CooperativeGoal?
  weeklyQuestionPlan WeeklyQuestionPlan?
  weeklyQuestionReviews WeeklyQuestionReview[]
  weeklyQuestionOccurrences WeeklyQuestionOccurrence[]
  targetedAlertAttempts TargetedAlertAttempt[]
  wowSelections WowGuildSelection[]
  wowChannels WowGuildChannel[]
  scopeKey            String @default("default")
  gameEdition         String @default("forever")
  // Owner-marked test server (Guild.isTestServer): kept out of public leaderboards, directory, pages and cross-server feeds; its own data is never hidden from it.
  isTestServer        Boolean @default(false)
  wowSpace            WowGuild? @relation("WowGuildScope")
  wowGuilds           WowGuild[]
  gameEventBoards GameEventBoard[]
  activityCores       ActivityCore[]
  id                  String                    @id @default(cuid())
  discordId           String
  name                String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  // Last upload from an officer's companion: /guilded verify codes only arrive that way.
  officerSyncAt       DateTime?
  members             Member[]
  transactions        DkpTransaction[]
  epgpTransactions    EpgpTransaction[]
  auditLogs           AuditLog[]
  imports             AddonImport[]
  heldEntries         AddonHeldEntry[]
  settings            GuildSettings?
  raids               Raid[]
  worldBuffDrops      WorldBuffDrop[]
  doNotInvites        DoNotInvite[]
  starboardPosts      StarboardPost[]
  auctions            Auction[]
  applications        Application[]
  lootAwards          LootAward[]
  tags                Tag[]
  bankRequests        BankRequest[]
  craftRequests       CraftRequest[]
  craftOffers         CraftOffer[]
  dungeonSeasons      DungeonSeason[]
    discordJobs         DiscordJob[]
    discordEvents       DiscordEventLink[]
  dungeonRuns         DungeonRun[]
  dungeonPoints       DungeonPointTransaction[]
  dungeonAchievements DungeonAchievement[]
  warcraftLogsReports WarcraftLogsReport[]
  consumableChecks    ConsumableCheck[]
  reserveList         ReserveList?
  recipesKnown        RecipeKnown[]
  coreItemValues      CoreItemValue[]
  professionCooldowns ProfessionCooldown[]
  itemReserves        ItemReserve[]
  raidCores           RaidCore[]
  raidSeasons         RaidSeason[]
  dungeonGroups       DungeonGroup[]
  groupAlerts         GroupAlert[]
  faqEntries          FaqEntry[]
  polls               Poll[]
  boardPosts          BoardPost[]
  unclaimedCharacters UnclaimedCharacter[]
  inviteRequests InviteRequest[]
  characterPairings   CharacterPairing[]
  characterVerifyCodes  CharacterVerifyCode[]
  characterVerifyClaims CharacterVerifyClaim[]
  communitySeasons    CommunitySeason[]
  communitySeasonCounters CommunitySeasonCounter[]
  poeMapVisits        PoeMapVisit[]
  memberOnboardings   MemberOnboarding[]
  communityHonors     CommunityHonors?
  communityHonorAwards CommunityHonorAward[]
  rookieMemberships CommunityRookieMembership[]
  page              GuildPage?
  recruitmentListings RecruitmentListing[]
  ladderSnapshots   LadderSnapshot[]
  @@unique([discordId, scopeKey])
}

// The guild's public web page at /g/<slug>/ (docs/GUILD_PAGES_DESIGN.md). Nothing is public until
// it is published, and each section stays hidden until it is listed in `sections`. The page shows
// character names only, never Discord users.
model GuildPage {
  id          String    @id @default(cuid())
  guildId     String    @unique
  slug        String    @unique
  published   Boolean   @default(false)
  // Turned-on sections: "cores", "loot", "rosters", "rankings", "recruitment".
  sections    String[]  @default([])
  intro       String?
  recruitment String?
  // A discord.gg or discord.com/invite link shown with the recruitment text.
  inviteUrl   String?
  // false: the page asks search engines not to index it.
  indexable   Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Onboarding progress of one Discord user in one server. Kept apart from Member so that reading
// the rules or being reminded never creates a roster entry.
model MemberOnboarding {
  guildId         String
  discordUserId   String
  rulesAcceptedAt DateTime?
  nudgedAt        DateTime?
  createdAt       DateTime  @default(now())
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, discordUserId])
}

// Discord community activities have their own seasons and wallet, separate from raid loot.
model CommunitySeason {
  id             String @id @default(cuid())
  guildId        String
  game           String
  name           String
  number         Int @default(1)
  channelId      String
  announcementChannelId String?
  audienceRoleId String?
  // Ends with its calendar month (guild time) and is followed by the next season.
  monthly        Boolean @default(true)
  status         String @default("ACTIVE")
  createdBy      String
  createdAt      DateTime @default(now())
  endedAt        DateTime?
  finalStandings Json?
  guild          Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  activities     CommunityActivity[]
  points         CommunityPoint[]
  participation  CommunityParticipationConfig?
  participationDays CommunityParticipationDay[]
  participationDeletions CommunityParticipationDeletion[]
  badgeConfig    CommunityBadgeConfig?
  badges         CommunityBadge[]
  badgeSharing   CommunityBadgeSharing[]
  kudos          CommunityKudos[]
  @@index([guildId, game, status])
  @@unique([guildId, game, number])
}

// Monotonic allocation survives deletion of a season; one counter per game/guild.
// Community recognition: the hall-of-fame channel, the weekly MVP role (most points earned in the
// last Monday-to-Sunday week, guild time) and the three podium roles of the last ended monthly
// season. Created by /setup; the community job moves the roles and posts the announcements.
model CommunityHonors {
  guildId         String   @id
  channelId       String?
  weeklyRoleId    String?
  monthRoleIds    Json     @default("[]")
  // Last week processed, as its Monday ("YYYY-MM-DD"), and who holds the weekly role.
  week            String?
  weeklyHolderIds Json     @default("[]")
  // Last ended season awarded, and the holders of each podium role (gold, silver, bronze).
  monthSeasonId   String?
  monthHolderIds  Json     @default("[[],[],[]]")
  rookieRoleId    String?
  rookieHolderId  String?
  // 9.0.2: the weekly rookie (best new member of the week), a cosmetic role like the others.
  weeklyRookieRoleId   String?
  weeklyRookieHolderId String?
  // Set when holders change; cleared once Discord roles match them.
  rolesPending    Boolean  @default(false)
  // Officer settings (/community honors-settings). Off: no weekly MVP or post.
  weeklyEnabled   Boolean  @default(true)
  // "MONDAY" (Monday to Sunday, guild time) or "RESET" (WoW weekly reset, Tuesday 15:00 UTC).
  weekStart       String   @default("MONDAY")
  pingMvp         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Independent of characters and Member records: relinking cannot reset eligibility.
model CommunityRookieMembership {
  guildId String
  userId String
  joinedAt DateTime
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@id([guildId, userId])
}

// Every MVP, rookie of the week and monthly podium place, for "3rd time MVP" and /community honors.
model CommunityHonorAward {
  id        String   @id @default(cuid())
  guildId   String
  // "WEEK" (MVP), "ROOKIE" or "MONTH" (podium place 1-3).
  kind      String
  // The week's first day ("YYYY-MM-DD") or the ended season's id.
  period    String
  place     Int      @default(1)
  userId    String
  points    Int?
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@unique([guildId, kind, period, userId])
  @@index([guildId, kind, createdAt])
}

model CommunitySeasonCounter {
  guildId String
  game String
  nextNumber Int @default(1)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@id([guildId, game])
}

model CommunityActivity {
  id          String @id @default(cuid())
  seasonId    String
  kind        String
  title       String
  rules       Json
  status      String @default("OPEN")
  startsAt    DateTime?
  endsAt      DateTime
  createdBy   String
  createdAt   DateTime @default(now())
  messageId   String?
  postedChannelId String?
  reminderAt  DateTime?
  result      Json?
  season      CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  entries     CommunityEntry[]
  @@index([status, endsAt])
  @@index([seasonId, kind])
}

model CommunityEntry {
  id          String @id @default(cuid())
  activityId  String
  userId      String
  status      String
  quantity    Int @default(1)
  evidence    String?
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  activity    CommunityActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  @@unique([activityId, userId])
}

model CommunityPoint {
  id        String @id @default(cuid())
  seasonId  String
  userId    String
  amount    Int
  kind      String
  reference String
  reason    String
  actorId   String
  createdAt DateTime @default(now())
  season    CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  @@unique([seasonId, reference])
  @@index([seasonId, userId])
  @@index([seasonId, userId, createdAt])
}

model CommunityParticipationConfig {
  seasonId String @id
  enabled Boolean @default(false)
  rules Json
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  season CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model CommunityParticipationDay {
  id String @id @default(cuid())
  seasonId String
  userId String
  day String
  messages Int @default(0)
  reactions Int @default(0)
  voiceMs Int @default(0)
  voicePoints Int @default(0)
  lastVoiceAt DateTime?
  lastMessageAt DateTime?
  messageHashes Json @default("[]")
  season CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  @@unique([seasonId, userId, day])
  @@index([seasonId, day])
}

model CommunityKudos {
  id String @id @default(cuid())
  seasonId String
  userId String
  nominatorId String
  week String
  reason String
  status String @default("PENDING")
  reviewedBy String?
  reviewNote String?
  // Review card in the Discord admin channel: null until posted, "posting" while being sent.
  cardMessageId String?
  createdAt DateTime @default(now())
  season CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  @@unique([seasonId, nominatorId, userId, week])
  @@index([seasonId, status])
}

model CommunityParticipationDeletion {
  seasonId String
  messageId String
  createdAt DateTime @default(now())
  season CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  @@id([seasonId, messageId])
}



model Member {
  // 8.5 track B: hide this member's characters from the race to 60 board.
  raceHidden Boolean @default(false)
  // Track M: the member turned off sharing their map position with the guild on the phone map
  // (their stored positions were deleted then; uploads keep none while this is true).
  mapShareOff Boolean @default(false)
  mapSightings GuildMapSighting[]
  helpCalls GuildHelpCall[]
  achievements MemberAchievement[]
  poeLevelsReached PoeLevelReached[]
  battlegroundReports BattlegroundReport[]
  battlegroundConsent BattlegroundConsent?
  duelWins DuelResult[] @relation("DuelWinner")
  duelLosses DuelResult[] @relation("DuelLoser")
  milestones MemberMilestone[]
  recurringRecap RecurringRecap?
  supplyPledges RaidSupplyPledge[]
  targetedAlertAttempts TargetedAlertAttempt[]
  webAvailability WebAvailability?
  activityCoreSpots   ActivityCoreMember[]
  activityResponses  ActivityResponse[]
  id                  String                       @id @default(cuid())
  guildId             String
  discordUserId       String
  displayName         String
  status              MembershipStatus             @default(ACTIVE)
  // Created by /testraid; removed by /testraid cleanup.
  isTest              Boolean                      @default(false)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  guild               Guild                        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters          Character[]
  transactions        DkpTransaction[]
  epgpTransactions    EpgpTransaction[]
  readinessSnapshots  InspectedCharacterSnapshot[]
  raidSignups         RaidSignup[]
  coreMemberships     RaidCoreMember[]
  dungeonGroupSignups DungeonGroupSignup[]
  groupAlert          GroupAlert?
  pollVotes           PollVote[]
  raidAttendance      RaidAttendance[]
  bids                AuctionBid[]
  lootAwards          LootAward[]
  applications        Application[]
  craftRequests       CraftRequest[]               @relation("CraftRequester")
  craftsClaimed       CraftRequest[]               @relation("CraftCrafter")
  craftOffers         CraftOffer[]
  dungeonRunPlayers   DungeonRunPlayer[]
  dungeonPoints       DungeonPointTransaction[]
  dungeonAchievements DungeonAchievement[]
  bankRequests        BankRequest[]
  // DM me when a profession cooldown of one of my characters is ready.
  cooldownPings       Boolean                      @default(false)
  characterPairings   CharacterPairing[]
  characterVerifyCodes  CharacterVerifyCode[]
  characterVerifyClaims CharacterVerifyClaim[]
  companionCredentials CompanionCredential[]
  pairedImports       AddonImport[]
  poeMapVisits        PoeMapVisit[]
  linkNotice          MemberLinkNotice?

  @@unique([guildId, discordUserId])
  @@index([guildId, status])
  // The public players page and profiles find a web account's members across guilds.
  @@index([discordUserId])
}

model Character {
  battlegroundReports BattlegroundReport[]
  webAvailability WebAvailability[]
  guildId            String
  gameEdition        String @default("forever")
  activityCoreSpots   ActivityCoreMember[]
  activityResponses  ActivityResponse[]
  id                 String                       @id @default(cuid())
  memberId           String
  name               String
  displayName        String?
  realm              String
  className          String
  spec               String?
  level              Int?
  isMain             Boolean                      @default(false)
  race               String?
  lastSeenAt         DateTime?
  professionsUpdatedAt DateTime?
  // 8.5 track K: the last time a guildmate's companion (not this member's own) updated this
  // character from the guild digest, and that guildmate's Member id ("reported by a guildmate").
  relayedAt          DateTime?
  relayedById        String?
  // 8.5: the pre-8.5 Forever first name this row had before it took its full "First Last" name
  // (owner backfill scripts/forever-names.ts, or the member's own upload). Never a key.
  legacyName         String?
  guildRankName     String?
  guildRankIndex    Int?
  guildRankAt       DateTime?
  rankSeen          CharacterRankSeen?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  member             Member                       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  professions        ProfessionSkill[]
  attunements        CharacterAttunement[]
  wishlist           WishlistEntry[]
  readinessSnapshots InspectedCharacterSnapshot[]
  coreSpots          RaidCoreMember[]
  coreBackups        RaidCoreBackup[]
  raidSignups        RaidSignup[]
  coreApplications   Application[]

  @@unique([guildId, gameEdition, realm, name])
  @@index([memberId, isMain])
}

model ProfessionSkill {
  id          String    @id @default(cuid())
  characterId String
  profession  String
  skillLevel  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, profession])
  @@index([profession, skillLevel])
}

model CharacterAttunement {
  id          String    @id @default(cuid())
  characterId String
  name        String
  completed   Boolean   @default(true)
  completedAt DateTime  @default(now())
  source      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, name])
  @@index([characterId, completed])
}

model DkpTransaction {
  id        String             @id @default(cuid())
  guildId   String
  memberId  String
  amount    Int
  type      DkpTransactionType
  reason    String
  sourceRef String?
  createdBy String
  createdAt DateTime           @default(now())
  guild     Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([guildId, createdAt])
  @@unique([guildId, sourceRef])
}

/// Append-only EPGP ledger. Corrections are represented by REVERSAL entries.
model EpgpTransaction {
  id        String              @id @default(cuid())
  guildId   String
  memberId  String
  epAmount  Int                 @default(0)
  gpAmount  Int                 @default(0)
  type      EpgpTransactionType
  reason    String
  sourceRef String?
  createdBy String
  // Set when the entry belongs to a raid core's own point pool; null = the guild pool.
  coreId    String?
  createdAt DateTime            @default(now())
  guild     Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member    Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([guildId, createdAt])
  @@index([guildId, sourceRef])
  @@unique([guildId, sourceRef])
}

model Auction {
  id           String        @id @default(cuid())
  guildId      String
  itemName     String
  minimumBid   Int
  bidIncrement Int
  status       AuctionStatus @default(ACTIVE)
  closesAt     DateTime
  createdBy    String
  closedAt     DateTime?
  // Optional context so loot history can show where an item came from.
  raidId       String?
  bossName     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  guild        Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  bids         AuctionBid[]
  lootAward    LootAward?

  @@index([guildId, status])
  @@index([guildId, closesAt])
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  memberId  String
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([auctionId, memberId])
  @@index([auctionId, amount])
}

model LootAward {
  id        String   @id @default(cuid())
  guildId   String
  // Null for loot given in game (addon import) rather than a Discord auction.
  auctionId String?  @unique
  // Addon loot row id, so re-importing never duplicates in-game loot.
  sourceRef String?  @unique
  memberId  String
  itemName  String
  amount    Int
  raidId    String?
  bossName  String?
  awardedBy String?
  epBefore  Int?
  gpBefore  Int?
  // The quote used in game, retained even when the core's prices later change.
  pricingSnapshot Json?
  awardedAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  auction   Auction? @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([guildId, awardedAt])
  @@index([memberId, awardedAt])
}

model Application {
  id           String            @id @default(cuid())
  guildId      String
  memberId     String
  // Which raid core this application is for; empty means a general guild application.
  coreId       String?
  status       ApplicationStatus @default(PENDING)
  character    String
  characterId  String?
  className    String
  spec         String
  experience   String
  availability String
  notes        String?
  // Tank / healer / DPS, picked before the form; used when the applicant is added to the core.
  role         RaidRole?
  reviewedBy   String?
  reviewedAt   DateTime?
  // The applications-channel card's message id, so a decision made with
  // /application approve|reject|trial can update the same card a button
  // click would have (show the decision, remove the buttons).
  cardMessageId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  guild        Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member       Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  core         RaidCore?         @relation(fields: [coreId], references: [id], onDelete: SetNull)
  linkedCharacter Character?     @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([guildId, status, createdAt])
  @@index([memberId, createdAt])
  @@index([coreId])
}

// Bot-wide, not per-guild (no FK to Guild): captured command/job failures and
// /report bug submissions, for the developer to review after a release. The
// guildId here is the raw Discord server ID, kept even if the guild is never
// otherwise seen again, and is null for a global/background-job error.
model ErrorReport {
  id        String   @id @default(cuid())
  source    String
  guildId   String?
  userId    String?
  message   String
  stack     String?
  context   String?
  // The bot version that saw it, and when the developer marked it fixed (npm run bugs).
  version    String?
  resolvedAt DateTime?
  resolution String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([guildId, createdAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  guildId   String
  actorId   String
  action    AuditAction
  entityId  String?
  metadata  Json
  createdAt DateTime    @default(now())
  guild     Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

model AddonImport {
  id             String   @id @default(cuid())
  guildId        String
  source         String
  checksum       String
  status         String
  payload        Json
  createdBy      String
  pairedMemberId String?
  createdAt      DateTime @default(now())
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  pairedMember   Member?  @relation(fields: [pairedMemberId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([pairedMemberId])
}

// A ledger or loot row from an addon export that could not be imported yet (unlinked character,
// no raid core chosen...). The rest of the export still imports; this row is retried on every
// later upload and leaves the list once it imports. A dismissed row is never imported.
model AddonHeldEntry {
  id          String    @id @default(cuid())
  guildId     String
  kind        String
  sourceRef   String
  character   String
  reason      String
  detail      String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  dismissedAt DateTime?
  dismissedBy String?
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, kind, sourceRef])
  @@index([guildId, dismissedAt, lastSeenAt])
}

// A Discord server can host several in-game guilds, including multiple guilds
// in the same edition. Selection must use this ID, never the Discord ID alone.
model WowGuild {
  id          String   @id @default(cuid())
  guildId     String
  gameEdition String
  name        String
  realm       String
  nameKey     String
  realmKey    String
  scopeGuildId String? @unique
  permissionRoles Json @default("{}")
  memberRoleId String?
  scope       Guild? @relation("WowGuildScope", fields: [scopeGuildId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, gameEdition, realmKey, nameKey])
  @@index([guildId, gameEdition])
}

model WowGuildSelection {
  discordId String
  userId String
  scopeGuildId String
  scopeGuild Guild @relation(fields: [scopeGuildId], references: [id], onDelete: Cascade)
  @@id([discordId, userId])
}

model WowGuildChannel {
  discordId String
  channelId String
  scopeGuildId String
  scopeGuild Guild @relation(fields: [scopeGuildId], references: [id], onDelete: Cascade)
  @@id([discordId, channelId])
}

model GuildSettings {
  // Rank roles (WoW guild rank to Discord role): on unless an officer turns it off; inert until a rank is mapped.
  rankRolesEnabled Boolean @default(true)
  // Private channel for Discord community officers (not the WoW officers' log): reviews and approvals.
  adminChannelId String?
  // New targeted alerts remain held until audience/channel/cadence approval.
  targetedAlertsEnabled Boolean @default(false)
  targetedAlertsAutomationApprovedBy String?
  targetedAlertsChannelId String?
  pugChannelId             String?
  pugMessageId             String?
  poeTrackingEnabled Boolean @default(false)
  // Achievements are viewable and recorded unless an officer turns them off. There is no announcement setting:
  // nothing is ever posted or awarded automatically.
  achievementsEnabled Boolean @default(true)
  // Opt-in celebration posts: off by default, an officer turns them on with /config achievements. Turning them
  // on first records everything already earned as announced, so there is no backfill.
  achievementAnnounceEnabled Boolean @default(false)
  achievementChannelId String?
  // Catalogue version this guild's announcements were last quietly baselined at (see ACHIEVEMENT_CATALOGUE_VERSION).
  achievementBaselineVersion Int @default(0)
  // Full setup reset excludes history that still exists on members' PCs.
  dataResetAt DateTime?
  id                       String    @id @default(cuid())
  guildId                  String    @unique
  attendanceDkp            Int       @default(10)
  lateAttendanceDkp        Int       @default(5)
  bossKillDkp              Int       @default(5)
  minimumBid               Int       @default(10)
  bidIncrement             Int       @default(5)
  auctionDurationSec       Int       @default(60)
  epgpDecayPercent         Float     @default(0.1)
  epgpDecayIntervalHours   Int       @default(168)
  epgpEnabled              Boolean   @default(true)
  welcomeChannelId         String?
  welcomeMessageTemplate   String?
  farewellChannelId        String?
  farewellMessageTemplate  String?
  applicantRoleId          String?
  memberRoleId             String?
  raidSignupChannelId      String?
  logChannelId             String?
  // Off by default: edited/deleted messages go to the officer log (content needs MESSAGE_CONTENT_INTENT).
  messageLogEnabled        Boolean   @default(false)
  // Starboard: messages with this many ⭐ are reposted there. Null = off.
  starboardChannelId       String?
  starboardThreshold       Int       @default(3)
  meritEnabled             Boolean   @default(false)
  // EPGP: PR = EP / (GP + baseGp), so a new player with almost no GP does not top the list.
  baseGp                   Int       @default(0)
  // Channel for raid/boss/loot/EPGP announcements.
  notifyChannelId          String?
  // Ping signed-up members this many minutes before a raid (0 = off).
  raidReminderMinutes      Int       @default(60)
  // Extra EP proposed when every planned boss of a raid dies.
  epCompletionBonus        Int       @default(0)
  // Weekly guild report posted to the notify channel.
  weeklyReportEnabled      Boolean   @default(false)
  weeklyReportLastAt       DateTime?
  // WoW report delivery is separate from future shared-guild and PoE reports.
  weeklyReportChannelId    String?
  // 8.5 batch 3 (#13/#14): the guild-invite channel where players post their full character name, the DM prompt for the WoW role, and the queue's off switch.
  inviteChannelId          String?
  inviteQueueEnabled       Boolean   @default(true)
  inviteDmEnabled          Boolean   @default(true)
  // 8.5 light recruiting kit: interview questions (JSON array of strings), the pinned guide message in the invite channel,
  // the recruiting post template and its shared cooldown (one reminder when it is over).
  inviteQuestions          Json?
  inviteGuideMessageId     String?
  recruitPostTemplate      String?
  recruitCooldownHours     Int       @default(72)
  recruitLastPostAt        DateTime?
  recruitLastPostBy        String?
  recruitRemindedAt        DateTime?
  inviteWowRoleId          String?
  // Opt-in: loot and EPGP belong to individual raid cores, never a shared guild pool.
  coreLootOnly             Boolean   @default(false)
  characterSignups         Boolean   @default(false)
  // EPGP decay applied by itself after each weekly reset (the guild pool and every core's own pool).
  autoDecay                Boolean   @default(false)
  lastAutoDecayAt          DateTime?
  // Bot messages the setup checklist watches: { [kind]: { channelId, messageId, version } }.
  botMessages              Json?
  // The answer channel (5.0): the bot replies there with officer-written answers (FaqEntry),
  // and, when aiAnswers is on and an AI endpoint is configured, with an AI answer otherwise.
  answerChannelId          String?
  aiAnswers                Boolean   @default(false)
  // IANA timezone for typing raid times ("friday 8pm") and showing them.
  timezone                 String    @default("America/Toronto")
  // "en" or "fr": language for member-facing bot messages.
  language                 String    @default("en")
  // Where the welcome message goes: CHANNEL, DM, or BOTH.
  welcomeDelivery          String    @default("CHANNEL")
  // Roles new members can pick with buttons on the welcome message (max 5).
  welcomeRoleIds           String[]  @default([])
  // Text above those buttons, e.g. "Which game are you here for?"
  welcomeRolePrompt        String?
  // Onboarding (welcome panel): where the server rules are, whether accepting them is required
  // before picking game roles or pairing (the applicant role is then given on acceptance, not on
  // join), and whether one private reminder goes out a day after joining.
  rulesChannelId           String?
  rulesGate                Boolean   @default(false)
  onboardingNudge          Boolean   @default(false)
  // Dungeon Challenge: announcements channel and point rules (JSON; missing
  // keys use the built-in defaults).
  bgCategoryId             String?
  bgGroupsChannelId        String?
  bgResultsChannelId       String?
  bgStatsChannelId         String?
  bgGroupsMessageId        String?
  bgResultsMessageId       String?
  bgStatsMessageId         String?
  // Live "Duels de la guilde" board kept in the PvP statistics channel (8.4.6): opt-in, one message edited in place.
  duelBoardEnabled         Boolean @default(true)
  duelBoardMessageId       String?
  // 8.5 track B: the duel ladder has its own channel (duel-ladder); the battleground ladder stays in bgStatsChannelId.
  duelBoardChannelId       String?
  // 8.5 track D: one auto-updated post per profession in the craft forum. On by default; officers switch it off
  // with /craft posts-setting. Posts are found by their thread title, so no message ids are stored.
  professionPostsEnabled   Boolean @default(true)
  // 8.5 track C: roster gaps, nickname sync and the Who's who board. All off until an officer turns them on.
  rosterIgnoredRoleIds     String[] @default([])
  nicknameSyncEnabled      Boolean @default(true)
  nicknameFormat           String?
  whosWhoEnabled           Boolean @default(true)
  whosWhoChannelId         String?
  whosWhoMessageId         String?
  // 8.5 track B: Race to 60 board (on by default, officers switch it off; posts once its channel exists) and the PvP channel module switch.
  raceBoardEnabled         Boolean @default(true)
  raceBoardChannelId       String?
  raceBoardMessageId       String?
  pvpModuleEnabled         Boolean @default(true)
  raceBoardTop             Int     @default(50)
  raceEnded                Boolean @default(false)
  raceHallBackfilledAt     DateTime?
  // 9.1 records and recaps (docs/plans/RECORDS_AND_RECAPS.md): record/challenge callouts on run posts and the daily recap card, both on by default.
  dungeonHighlightsEnabled Boolean @default(true)
  dailyRecapEnabled        Boolean @default(true)
  dailyRecapLastDay        String?
  // Separate battleground ladder message in the ladder channel (the duel board keeps its own message and points).
  bgLadderEnabled          Boolean @default(true)
  bgLadderMessageId        String?
  // 8.5 track C5: promotion panel (Initiate -> Member). On by default; officers change the rule or switch it off.
  promotionEnabled         Boolean @default(true)
  promotionFromRank        String  @default("Initiate")
  promotionMinDays         Int     @default(7)
  promotionMinLevel        Int?
  promotionWeeklyEnabled   Boolean @default(true)
  promotionChannelId       String?
  promotionLastPostAt      DateTime?
  // 9.0 guild bank ledger: weekly summary in the officer log channel (on by default; /officer stats bank).
  guildBankWeeklyEnabled   Boolean @default(true)
  guildBankLastPostAt      DateTime?
  // 9.1 (docs/plans/GUILD_BANK.md), on by default with officer off switches (/bank settings):
  // members can search the bank contents (never the ledger); bank requests get a card with
  // buttons in the request channel (else the log channel); low-stock alerts in the log channel.
  guildBankMemberSearch    Boolean @default(true)
  guildBankRequestPosts    Boolean @default(true)
  guildBankStockAlerts     Boolean @default(true)
  // Track M: the guildmate map on the phone (last-seen positions, heat map, help pins). Officers' off switch.
  guildMapEnabled          Boolean @default(true)
  bankRequestChannelId     String?
  // 9.1 in-game guild board (docs/GUILD_BOARD.md): officers' news and open polls in the addon,
  // voting from the game. On by default; officers turn it off with /poll board.
  guildBoardEnabled        Boolean @default(true)
  dungeonChannelId         String?
  dungeonConfig            Json?
  // Monthly dungeon seasons (opt-in; src/services/dungeon-season-schedule.ts).
  dungeonSeasonSchedule    Json?
  // Raid summaries (raid reports) post here; falls back to the notify channel.
  raidLogChannelId         String?
  // Dungeon challenge: an auto-updated leaderboard message, and a signups channel.
  dungeonLeaderboardChannelId String?
  dungeonLeaderboardMessageId String?
  dungeonSignupChannelId   String?
  // Loot awards and EP/GP changes post here; falls back to the notify channel.
  lootChannelId            String?
  // Craft requests post here (crafters see them); falls back to the officer log.
  craftChannelId           String?
  // 9.1 (owner, 7 November 2026): open craft requests one message each, and finished ones, in their
  // own channels (/setup creates them). craftOrdersEnabled is the officer off switch for both.
  craftOrdersChannelId     String?
  craftArchiveChannelId    String?
  craftOrdersEnabled       Boolean @default(true)
  // Pings to opted-in crafters who know the recipe (/craft notify); officer off switch.
  craftPingsEnabled        Boolean @default(true)
  // 9.1 (owner, 7 November 2026): the "Top crafters" ladder card (craft-ladder.ts); officer off switch.
  craftLadderEnabled       Boolean @default(true)
  craftLadderChannelId     String?
  craftLadderMessageId     String?
  // Crafter offers (sell a craft) are off until an officer turns them on with /craft offer-setting.
  craftOffersEnabled       Boolean @default(false)
  // Crafting orders in game (docs/plans/CRAFTING_ORDERS.md): craft requests on the addon's Orders page. On by default; /craft orders-setting.
  craftOrdersInGame        Boolean @default(true)
  // Private (officers and raid leaders) channel where gear/readiness checks are posted.
  readinessChannelId       String?
  // 9.1 readiness upgrade (docs/plans/READINESS_UPGRADE.md): the daily list and the raid night check card; on by default, officers switch both off.
  readinessPostsEnabled    Boolean   @default(true)
  // 9.1 guild activity ladder (docs/plans/GUILD_ACTIVITY_LADDER.md): dungeons + duels + battlegrounds in one board; on by default.
  activityBoardEnabled     Boolean   @default(true)
  activityBoardMessageId   String?
  // Where each raid core's roster is shown (one live message per core).
  coreChannelId            String?
  // Private channel where new applications are posted; falls back to the officer log.
  applicationChannelId     String?
  attendanceChannelId      String?
  // Public channel with the pinned getting-started guide; also where a short
  // notice posts when the bot/addon version changes (they share one version).
  guideChannelId           String?
  lastAnnouncedVersion     String?
  // Newest release the officers were told is available (src/services/update-check.ts).
  lastUpdateNoticeVersion  String?
  // "EPGP" (bids decide) or "COUNCIL" (officers decide with /loot award; bids are off).
  lootMode                 String    @default("EPGP")
  // true: an addon upload from the companion is applied right away, with no /import-apply.
  // Warcraft Logs guild whose new reports are found automatically (set with /config wcl-guild).
  wclGuildId               Int?
  wclBaseUrl               String?
  autoApplyImports         Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  guild                    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // Public sharing (/mod leaderboard). False remains the fallback for legacy/missing settings.
  publicDungeonRuns        Boolean   @default(false)
  // New-guild automatic sharing only includes runs started at/after setup. Null preserves existing opt-ins.
  publicDungeonRunsSince   DateTime?
  // 8.5 track G: daily statistics snapshots (on unless an officer turns them off) and the read-only CSV feed
  // for Google Sheets. Only a SHA-256 hash of the feed key is stored; null = no feed.
  statsEnabled             Boolean   @default(true)
  statsFeedKeyHash         String?
  statsFeedKeyAt           DateTime?
}

// Personal, self-reported log observations; never completion evidence or loot points.
model PoeMapVisit {
  id              String @id @default(cuid())
  guildId         String
  memberId        String
  runRef          String
  instanceRef     String?
  character       String
  league          String
  mode            String
  areaId          String
  areaLevel       Int
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int?
  endReason       String
  source          String @default("CLIENT_LOG")
  createdAt       DateTime @default(now())
  guild           Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member          Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([guildId, memberId, runRef])
  @@index([guildId, league, mode, startedAt])
  @@index([memberId, startedAt])
}

model InspectedCharacterSnapshot {
  id          String                @id @default(cuid())
  characterId String
  memberId    String
  inspectedAt DateTime              @default(now())
  source      String
  status      ReadinessStatus       @default(UNKNOWN)
  itemLevel   Float?
  rawPayload  Json?
  character   Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  member      Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items       CharacterItem[]
  consumables CharacterConsumable[]
  findings    ReadinessFinding[]

  @@index([characterId, inspectedAt])
  @@index([memberId, inspectedAt])
}

model CharacterItem {
  id         String                     @id @default(cuid())
  snapshotId String
  slot       String
  itemId     String?
  itemName   String
  itemLevel  Int?
  durability Int?
  snapshot   InspectedCharacterSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  enchants   CharacterEnchant[]

  @@unique([snapshotId, slot])
  @@index([itemName])
}

model CharacterEnchant {
  id        String        @id @default(cuid())
  itemId    String
  slot      String
  enchantId String?
  name      String
  item      CharacterItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, slot])
}

model CharacterConsumable {
  id         String                     @id @default(cuid())
  snapshotId String
  name       String
  quantity   Int
  category   String?
  snapshot   InspectedCharacterSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, name])
}

model ReadinessFinding {
  id         String                     @id @default(cuid())
  snapshotId String
  code       String
  severity   ReadinessFindingSeverity
  message    String
  resolved   Boolean                    @default(false)
  snapshot   InspectedCharacterSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, severity])
}

model Raid {
  planningRevisions RaidPlanRevision[]
  // Explicit opt-in for this occurrence only; weekly successors start private.
  publicPug       Boolean          @default(false)
  pugRealm        String?
  pugFaction      String?
  pugLanguage     String?
  pugInviteUrl    String?
  id              String           @id @default(cuid())
  guildId         String
  title           String
  description     String?
  scheduledAt     DateTime
  status          RaidStatus       @default(PLANNED)
  // Created by /testraid; removed by /testraid cleanup.
  isTest          Boolean          @default(false)
  createdBy       String
  startedAt       DateTime?
  endedAt         DateTime?
  tankLimit       Int?
  healerLimit     Int?
  dpsLimit        Int?
  // Optional seats inside the DPS role: melee and ranged, worked out from each player's spec.
  meleeLimit      Int?
  rangedLimit     Int?
  signupChannelId String?
  signupMessageId String?
  mirrorSignupChannelId String?
  mirrorSignupMessageId String?
  // Optional: no new signups or role changes after this; Can't come and Late still work.
  signupsCloseAt  DateTime?
  // Raids created for a raid core give that core's members signup priority.
  coreId          String?
  core            RaidCore?        @relation(fields: [coreId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  guild           Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  signups         RaidSignup[]
  attendance      RaidAttendance[]
  notes           RaidNote[]
  reminderSentAt  DateTime?
  // Weekly raids: ending one creates the next, seven days on.
  repeatWeekly    Boolean          @default(false)
  // Original core/date/time identity; retained when cancelled or moved so it never respawns.
  weeklyOccurrence String?         @unique
  bosses          RaidBoss[]

  @@index([guildId, scheduledAt])
  @@index([guildId, status])
  @@index([publicPug, status, scheduledAt])
}

model RaidSignup {
  id          String           @id @default(cuid())
  raidId      String
  memberId    String
  characterId String?
  characterName String?
  characterRealm String?
  role        RaidRole         @default(DPS)
  // The spec the player picked for this raid; empty means their character's current spec.
  spec        String?
  status      RaidSignupStatus @default(SIGNED_UP)
  signedUpAt  DateTime         @default(now())
  cancelledAt DateTime?
  // The member's own "I'll be late" (the Late button). Attendance is still recorded separately.
  late        Boolean          @default(false)
  raid        Raid             @relation(fields: [raidId], references: [id], onDelete: Cascade)
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  character   Character?       @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([raidId, memberId])
  @@unique([raidId, characterId])
  @@index([raidId, status])
}

// A world-buff drop a member announced (Classic Era / Forever): who drops which buff, when
// and where. Entered by players, never generated; past drops are pruned when new ones are added.
model WorldBuffDrop {
  id        String   @id @default(cuid())
  guildId   String
  buff      String
  dropsAt   DateTime
  location  String?
  note      String?
  createdBy String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, dropsAt])
}

// Officers' shared "do not invite" list. Officer-only: never shown to members. A match warns
// the officer log (applications, Discord joins); nothing is blocked automatically.
model DoNotInvite {
  id            String   @id @default(cuid())
  guildId       String
  name          String
  realm         String?
  discordUserId String?
  reason        String
  addedBy       String
  createdAt     DateTime @default(now())
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// One starboard repost per starred message, updated as stars change.
model StarboardPost {
  id                 String   @id @default(cuid())
  guildId            String
  sourceChannelId    String
  sourceMessageId    String   @unique
  starboardChannelId String
  starboardMessageId String
  stars              Int
  createdAt          DateTime @default(now())
  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model RaidAttendance {
  id         String               @id @default(cuid())
  raidId     String
  memberId   String
  status     RaidAttendanceStatus
  recordedBy String
  notes      String?
  recordedAt DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  raid       Raid                 @relation(fields: [raidId], references: [id], onDelete: Cascade)
  member     Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([raidId, memberId])
  @@index([raidId, status])
}

// A raid attendance season: a date range. A raid belongs to it by its date (no link on Raid),
// so raids from before the season was created are covered too.
model RaidSeason {
  id               String    @id @default(cuid())
  guildId          String
  name             String
  startsAt         DateTime
  // Empty: still running. Set when the next season starts.
  endsAt           DateTime?
  // The live summary in the officers' attendance channel, edited after each raid report.
  summaryChannelId String?
  summaryMessageId String?
  createdBy        String
  createdAt        DateTime  @default(now())
  guild            Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId, startsAt])
}

model RaidBoss {
  id        String         @id @default(cuid())
  raidId    String
  name      String
  sortOrder Int            @default(0)
  status    RaidBossStatus @default(PENDING)
  killedAt  DateTime?
  raid      Raid           @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@unique([raidId, name])
  @@index([raidId, sortOrder])
}

model Tag {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  content   String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
}

model WishlistEntry {
  id          String    @id @default(cuid())
  characterId String
  itemKey     String
  itemName    String
  priority    Int       @default(2)
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, itemKey])
  @@index([itemKey])
}

// Officer notes on a raid: general, per boss, or "improve next time".
model RaidNote {
  id        String   @id @default(cuid())
  raidId    String
  bossName  String?
  body      String
  createdBy String
  createdAt DateTime @default(now())
  raid      Raid     @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@index([raidId, createdAt])
}

// Explicitly approved member-facing plans; never reuse private RaidNote records.
model RaidPlanRevision {
  id String @id @default(cuid())
  raidId String
  kind String
  revision Int
  active Boolean @default(true)
  payload Json
  approvedBy String
  approvedAt DateTime @default(now())
  raid Raid @relation(fields: [raidId], references: [id], onDelete: Cascade)
  pledges RaidSupplyPledge[]
  @@unique([raidId, kind, revision])
}

model RaidSupplyPledge {
  revisionId String
  memberId String
  itemIndex Int
  quantity Int
  delivered Int @default(0)
  updatedAt DateTime @updatedAt
  revision RaidPlanRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@id([revisionId, memberId, itemIndex])
}

enum BankRequestStatus {
  PENDING
  APPROVED
  FULFILLED
  DENIED
  CANCELLED
}

// A member asking the guild bank for an item; officers approve, fulfil, or deny.
model BankRequest {
  id        String            @id @default(cuid())
  guildId   String
  memberId  String
  item      String
  quantity  Int               @default(1)
  note      String?
  status    BankRequestStatus @default(PENDING)
  handledBy String?
  handledAt DateTime?
  reply     String?
  // 9.1 (docs/plans/GUILD_BANK.md): the bank item when the request matched the contents; where it
  // was made ("discord" or "addon"); the addon's own id for it, so a re-upload is the same request;
  // and the officer queue card (channel and message) the bot posted for it.
  itemId    Int?
  source    String            @default("discord")
  clientRef String?
  channelId String?
  messageId String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  guild     Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([guildId, clientRef])
  @@index([guildId, status, createdAt])
  @@index([memberId, createdAt])
}

enum CraftOfferStatus {
  ACTIVE
  WITHDRAWN
  EXPIRED
}

// A crafter's offer to make something (price is free text: Guilded never handles gold).
model CraftOffer {
  id                String           @id @default(cuid())
  guildId           String
  crafterId         String
  character         String?
  item              String
  itemKey           Int?
  profession        String?
  // True when the item comes from a recipe the crafter's character was recorded with.
  verified          Boolean          @default(false)
  price             String?
  materialsProvided Boolean          @default(false)
  note              String?
  threadId          String?
  status            CraftOfferStatus @default(ACTIVE)
  expiresAt         DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  guild             Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  crafter           Member           @relation(fields: [crafterId], references: [id], onDelete: Cascade)

  @@index([guildId, status, expiresAt])
  @@index([crafterId, createdAt])
}

enum CraftRequestStatus {
  OPEN
  CLAIMED
  DONE
  CANCELLED
}

// A member asking a guild crafter to make something; a crafter claims it.
model CraftRequest {
  id                String             @id @default(cuid())
  guildId           String
  requesterId       String
  crafterId         String?
  item              String
  profession        String?
  quantity          Int                @default(1)
  note              String?
  materialsProvided Boolean            @default(false)
  // The forum post (thread) on the craft board, when the craft channel is a forum.
  threadId          String?
  // The offer this request answers ("I'd like this"), when it came from one.
  offerId           String?
  // Crafting orders in game (docs/plans/CRAFTING_ORDERS.md): the recipe (item id, or minus an enchant's
  // spell id, the addon's key) when known, the character it was asked of, the character that claimed it
  // in game, and where the claim came from ("discord" or "game").
  itemKey           Int?
  askedCharacter    String?
  crafterCharacter  String?
  claimSource       String?
  // 9.1: its line in the craft orders channel and, once finished, in the archive.
  orderMessageId    String?
  archiveMessageId  String?
  status            CraftRequestStatus @default(OPEN)
  claimedAt         DateTime?
  doneAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  guild             Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  requester         Member             @relation("CraftRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  crafter           Member?            @relation("CraftCrafter", fields: [crafterId], references: [id], onDelete: SetNull)

  @@index([guildId, status, createdAt])
  @@index([requesterId])
  @@index([crafterId])
}

// 9.1 (owner, 7 November 2026): a member who wants a ping when someone asks for a craft of this
// profession that one of their characters knows (/craft notify). Opt-in; lastPingAt rate-limits.
model CraftNotify {
  id         String    @id @default(cuid())
  guildId    String
  memberId   String
  profession String
  lastPingAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([memberId, profession])
  @@index([guildId, profession])
}

// 9.1 (owner, 7 November 2026): the guild's craft history and crafter points. One row per finished
// craft: from the craft board (requestId, once each) or, later, from in-game orders (source "game").
// One point per completed craft; `points` is stored so a later weighting never rewrites history.
model CraftCompletion {
  id         String   @id @default(cuid())
  guildId    String
  crafterId  String
  item       String
  quantity   Int      @default(1)
  profession String?
  source     String   @default("board")
  requestId  String?  @unique
  points     Int      @default(1)
  doneAt     DateTime
  createdAt  DateTime @default(now())

  @@index([guildId, doneAt])
  @@index([crafterId])
}

// ---------------------------------------------------------------------
// Dungeon Challenge (roadmap D3-D8). Runs come from the addon via the
// companion import; points are computed here from rules, never sent by the
// addon.
// ---------------------------------------------------------------------

// The bot-wide dungeon season calendar (7.3): set only by the bot's owner with /guilded-season.
// A season runs from its start to the next season's start; the last one has no end yet. Every
// guild's dungeon season and the public leaderboards follow it (official-seasons.ts).
model OfficialSeason {
  gameEdition String @default("forever")
  id        String   @id @default(cuid())
  number    Int
  name      String
  startsAt  DateTime
  createdBy String?
  // Public leaderboard rules, frozen when the season starts (public-score.ts PublicRuleSnapshot).
  rules     Json?
  createdAt DateTime @default(now())
  @@unique([gameEdition, number])
  @@unique([gameEdition, startsAt])
}

model DungeonSeason {
  id           String                    @id @default(cuid())
  guildId      String
  name         String
  startsAt     DateTime                  @default(now())
  endsAt       DateTime?
  // ACTIVE, CLOSING (v2 upload grace), or ENDED. Ended seasons stay viewable forever.
  status       String                    @default("ACTIVE")
  // Published final standings. Later ledger corrections do not rewrite the award ceremony.
  finalStandings Json?
  rulesSnapshot Json?
  // Frozen at season creation. Null preserves legacy participation seasons.
  ratingRules   Json?
  finalRating   Json?
  createdAt    DateTime                  @default(now())
  guild        Guild                     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  runs         DungeonRun[]
  points       DungeonPointTransaction[]
  achievements DungeonAchievement[]

  @@index([guildId, status])
}

// One native Discord event per raid or gaming night. Separate from signups.
model DiscordEventLink {
  id String @id @default(cuid())
  guildId String
  sourceType String
  sourceId String
  discordId String? @unique
  signature String?
  settled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@unique([guildId, sourceType, sourceId])
}

model DiscordJob {
  id String @id @default(cuid())
  guildId String
  key String
  kind String
  payload Json
  revision Int @default(1)
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  lockedUntil DateTime?
  lastError String?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@unique([guildId, key])
  @@index([status, nextAttemptAt])
}

model DungeonRun {
  id              String                    @id @default(cuid())
  guildId         String
  // The addon's run id (e.g. QG-20260925-120000-Kev); one row per run.
  runRef          String
  instanceId      Int
  dungeonName     String
  difficultyId    Int                       @default(0)
  // COMPLETED, ABANDONED, or INVALID, as reported by the addon.
  state           String
  // false when validation or an officer rejected it (kept for the audit).
  valid           Boolean                   @default(true)
  invalidReason   String?
  startedAt       DateTime?
  endedAt         DateTime?
  durationSec     Int?
  completedBy     String?
  recorder        String?
  // Observed party levels and encounter timestamps; absent in old runs.
  competitionData Json?
  reporters       Int                       @default(1)
  // Characters whose addon reported the run, lowercase, when the companion said (7.4).
  reporterNames   String[]                  @default([])
  protocolVersion Int
  addonVersion    String?
  seasonId        String?
  importId        String?
  createdAt       DateTime                  @default(now())
  guild           Guild                     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  season          DungeonSeason?            @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  players         DungeonRunPlayer[]
  highlights      DungeonHighlight[]
  points          DungeonPointTransaction[]
  achievements    DungeonAchievement[]

  @@unique([guildId, runRef])
  @@index([guildId, instanceId, valid])
  @@index([guildId, endedAt])
}

model DungeonRunPlayer {
  id         String     @id @default(cuid())
  runId      String
  character  String
  memberId   String?
  class      String?
  role       String?
  // null = not tracked (player had no addon); never guessed.
  deaths     Int?
  presentSec Int        @default(0)
  inGuild    Boolean    @default(false)
  run        DungeonRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  member     Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([memberId])
}

// Every point change, with why. Totals and rankings are computed from these.
model DungeonPointTransaction {
  id        String         @id @default(cuid())
  guildId   String
  memberId  String
  runId     String?
  seasonId  String?
  amount    Int
  reason    String
  // "rule:<name>" for automatic points, "admin" for manual changes.
  source    String
  createdBy String
  createdAt DateTime       @default(now())
  guild     Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  run       DungeonRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  season    DungeonSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([memberId, createdAt])
  @@index([runId])
}

// Permanent dungeon achievements (roadmap D8), one per member per key.
// Season Champion is keyed per season (seasonChampion:<seasonId>). Removed
// with the run that earned it if an officer invalidates that run.
model DungeonAchievement {
  id       String         @id @default(cuid())
  guildId  String
  memberId String
  key      String
  runId    String?
  seasonId String?
  earnedAt DateTime       @default(now())
  revokedAt DateTime?
  guild    Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  run      DungeonRun?    @relation(fields: [runId], references: [id], onDelete: Cascade)
  season   DungeonSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@unique([guildId, memberId, key])
  @@index([runId])
}

// A Warcraft Logs report pulled with /wcl report: a compact summary kept so
// the raid report can link to it. No per-player performance numbers.
model WarcraftLogsReport {
  id        String   @id @default(cuid())
  guildId   String
  code      String
  url       String
  title     String
  zone      String?
  owner     String?
  startedAt DateTime
  endedAt   DateTime
  summary   Json
  // Officer-only extras (consumables at each pull, deaths); never shown in public posts.
  details   Json?
  // The Discord raid this log belongs to, when the officer linked one.
  raidId    String?
  createdBy String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, code])
  @@index([guildId, startedAt])
  @@index([raidId])
}

// The latest consumable scan result per character (from /guilded consumes in game).
model ConsumableCheck {
  id        String   @id @default(cuid())
  guildId   String
  character String
  realm     String
  flask     String?
  elixirs   String[] @default([])
  food      String?
  weapon    String?
  scannedAt DateTime
  scannedBy String   @default("")
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, character, realm])
  @@index([guildId, scannedAt])
}

// The soft-reserve list kept in the addon (/guilded reserve), copied here from the
// companion's export. One list per guild; a newer export replaces it.
model ReserveList {
  guildId   String   @id
  title     String   @default("")
  perPlayer Int      @default(1)
  open      Boolean  @default(false)
  active    Boolean  @default(false)
  keeper    String   @default("")
  syncedAt  DateTime
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model ItemReserve {
  id        String   @id @default(cuid())
  guildId   String
  character String
  realm     String
  itemId    Int
  itemName  String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, character, realm, itemId])
  @@index([guildId, itemId])
}

// One recipe a character knows, from the addon's profession scan (/guilded recipes).
// itemKey is an item id, or minus a spell id for enchants.
model RecipeKnown {
  id         String   @id @default(cuid())
  guildId    String
  character  String
  realm      String
  profession String
  itemKey    Int
  itemName   String
  scannedAt  DateTime
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, character, realm, itemKey])
  @@index([guildId, itemKey])
  @@index([guildId, character, realm, profession])
}

model ProfessionCooldown {
  id         String    @id @default(cuid())
  guildId    String
  character  String
  realm      String
  profession String
  name       String
  readyAt    DateTime
  scannedAt  DateTime
  notifiedAt DateTime?
  guild      Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, character, realm, profession, name])
  @@index([guildId, readyAt])
}

// The set GP price of an item (EPGP priority loot). coreId "" is the guild-wide default; a
// core's own price for the same item wins. itemKey is the lower-case item name, or "#id" for
// a price given by item id only.
model CoreItemValue {
  id        String   @id @default(cuid())
  guildId   String
  coreId    String   @default("")
  itemKey   String
  itemId    Int?
  itemName  String
  gp        Int
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, coreId, itemKey])
  @@index([guildId, coreId])
}

// A named raid roster. Members get priority at signups for raids made for it.
model RaidCore {
  id              String           @id @default(cuid())
  guildId         String
  name            String
  description     String?
  // The realm this core plays on. Empty: the realm its characters already share.
  realm           String?
  // Recurring raid nights, e.g. "Tue/Thu 8-11pm EST"; shown on the roster message.
  schedule        String?
  // Explicitly enabled only by a leader. Old free-text schedules remain display-only.
  weeklySchedule  String?
  weeklyTimezone  String?
  weeklyCreatedBy String?
  weeklyStartDate String?
  weeklyHorizonDays Int @default(6)
  raidSize        Int?
  tankLimit       Int?
  healerLimit     Int?
  dpsLimit        Int?
  rosterMessageId String?
  // Per-core EP rules; empty means the guild's default from /config.
  attendanceEp    Int?
  lateEp          Int?
  bossEp          Int?
  completionEp    Int?
  baseGp          Int?
  decayPercent    Float?
  // "EPGP", "COUNCIL", "RESERVE" or "PRIORITY"; empty follows the guild's /config loot-mode.
  lootMode        String?
  // Soft reserves per player for this core (RESERVE mode); empty = 1.
  reservesPerPlayer Int?
  // true: this core keeps its own EP/GP, apart from the guild pool.
  separatePool    Boolean          @default(false)
  // Share of an item's GP an off-spec winner pays, in percent; empty = 50.
  offspecPercent  Int?
  // EP a player needs before they take priority over players below it (EPGP minimum EP); empty = 0.
  minEp           Int?
  // Opt-in, versioned flat-slot pricing. Null preserves existing pricing behavior.
  pricingPolicy   Json?
  pricingRevision Int @default(0)
  pricingAutoDecay Boolean @default(false)
  lastPricingDecayAt DateTime?
  // The core's own Discord role (given to its members, trial members included) and, once created
  // with "Create channels", its category and channels. Empty = the guild's shared channels.
  roleId          String?
  categoryId      String?
  rosterChannelId String?
  signupChannelId String?
  lootChannelId   String?
  raidLogChannelId String?
  chatChannelId   String?
  voiceChannelId  String?
  // Officers-only: who was present, late, benched or absent at each of this core's raids.
  attendanceChannelId String?
  // Officers-only: this core's own applications. Empty = the guild's common applications channel.
  applicationChannelId String?
  // Extra Discord role (this core's officers) allowed to read the application channel.
  officerRoleId   String?
  // Short free-text summary of the core's loot rules, shown on its roster post.
  lootRulesNote   String?
  // Set by an officer's Archive button; an archived core takes no applications and spawns no weekly raids.
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  guild           Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members         RaidCoreMember[]
  raids           Raid[]
  applications    Application[]
  recruitmentListing RecruitmentListing?

  @@unique([guildId, name])
}

model RaidCoreMember {
  id       String   @id @default(cuid())
  coreId   String
  memberId String
  role     RaidRole @default(DPS)
  bench    Boolean  @default(false)
  // On trial (an application moved to Trial): shown apart on the roster until approved.
  trial    Boolean  @default(false)
  // Trial bookkeeping: when it started and ends, who vouched (Discord user id), and when the
  // officer log was told it ended (once).
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  trialSponsorId  String?
  trialRemindedAt DateTime?
  // The character they bring to this core (one member can be in several cores, with the same
  // character or a different one in each). Empty = not said: the roster shows only their name.
  characterId String?
  addedAt  DateTime @default(now())
  core     RaidCore @relation(fields: [coreId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  // Other characters they can bring to this same core (e.g. a healer alt as a backup).
  backups  RaidCoreBackup[]

  @@unique([coreId, memberId])
  @@index([memberId])
}

// A backup character a core member can bring to that core instead of their usual one, with its
// own role. Deleted with the core spot or the character.
model RaidCoreBackup {
  id          String         @id @default(cuid())
  spotId      String
  characterId String
  role        RaidRole       @default(DPS)
  addedAt     DateTime       @default(now())
  spot        RaidCoreMember @relation(fields: [spotId], references: [id], onDelete: Cascade)
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([spotId, characterId])
}

enum DungeonGroupStatus {
  OPEN
  STARTED
  CLOSED
}

// A 5-player dungeon signup posted with buttons; gets a temporary voice
// channel when it starts.
model DungeonGroup {
  id               String               @id @default(cuid())
  guildId          String
  title            String
  // DUNGEON, LEVELING, PVP, WORLDPVP, WORLD or OTHER (the group finder); sets size and roles.
  kind             String               @default("DUNGEON")
  maxSize          Int                  @default(5)
  // The level range players need (5.0: from the form, or guessed from the dungeon in the title);
  // group alerts only ping members with a linked character in it. Null = any level.
  minLevel         Int?
  maxLevel         Int?
  leaderId         String
  status           DungeonGroupStatus   @default(OPEN)
  signupChannelId  String?
  signupMessageId  String?
  voiceChannelId   String?
  // Set while the voice channel has nobody in it; it is deleted after a few minutes.
  voiceEmptySince  DateTime?
  createdAt        DateTime             @default(now())
  startedAt        DateTime?
  closedAt         DateTime?
  guild            Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  signups          DungeonGroupSignup[]

  @@index([guildId, status])
}

model DungeonGroupSignup {
  id       String           @id @default(cuid())
  groupId  String
  memberId String
  role     RaidRole         @default(DPS)
  status   RaidSignupStatus @default(SIGNED_UP)
  joinedAt DateTime         @default(now())
  group    DungeonGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
}

// A member's group alerts (5.0): ping me in the group finder when a group of these kinds is
// posted that my linked characters' level fits and that still needs one of my roles.
model GroupAlert {
  // Explicit advanced subscription; null retains the legacy panel behavior.
  subscription Json?
  id        String   @id @default(cuid())
  guildId   String
  memberId  String   @unique
  // GroupKind values (DUNGEON, LEVELING, PVP, WORLDPVP, WORLD, OTHER).
  kinds     String[]
  // RaidRole values the member plays; empty = any role.
  roles     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// An answer officers wrote for the bot's answer channel (5.0): when a message there matches
// one of the triggers, the bot replies with the answer.
model FaqEntry {
  id        String   @id @default(cuid())
  guildId   String
  // Lower-case words or phrases; a message matches when it contains all words of one of them.
  triggers  String[]
  answer    String
  uses      Int      @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// An officer poll answered with buttons; each member picks up to maxChoices options, changeable.
model Poll {
  id        String     @id @default(cuid())
  guildId   String
  question  String
  options   String[]
  createdBy String
  channelId String?
  messageId String?
  closed    Boolean    @default(false)
  maxChoices Int       @default(1)
  closesAt  DateTime?
  createdAt DateTime   @default(now())
  guild     Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([guildId, closed])
}

model PollVote {
  id       String   @id @default(cuid())
  pollId   String
  memberId String
  option   Int
  votedAt  DateTime @default(now())
  poll     Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([pollId, memberId, option])
}

// 9.1 in-game guild board (docs/GUILD_BOARD.md): an officer's news post, from Discord (/poll news)
// or from the game (the addon's Board page, uploaded by the officer's companion). Shown on the
// addon's Board page; a post from the game is also posted in the announcements channel.
model BoardPost {
  id        String    @id @default(cuid())
  guildId   String
  body      String
  // The name shown in game: the officer's Discord display name or character name.
  author    String
  authorId  String?
  memberId  String?
  source    String    @default("discord")
  // The addon's own reference for a post from the game, so a resent upload posts it once.
  clientRef String?
  channelId String?
  messageId String?
  removedAt DateTime?
  createdAt DateTime  @default(now())
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, clientRef])
  @@index([guildId, createdAt])
}

// A character the addons revealed (through the guild digest) that no Discord
// member has linked yet. It is linked automatically when a Discord name
// matches, or by its owner with /character claim.
model UnclaimedCharacter {
  gameEdition String @default("forever")
  id          String   @id @default(cuid())
  guildId     String
  // Lowercase name: Forever realms are unreliable, so a name identifies it.
  nameKey     String
  name        String
  displayName String?
  // 8.5: the pre-8.5 Forever first name this row had before it took its full name.
  legacyName  String?
  realm       String
  className   String
  race        String?
  level       Int?
  spec        String?
  professions Json?
  professionsUpdatedAt DateTime?
  lastSeenAt  DateTime @default(now())
  // 8.5 track C5: the rank the officer's roster upload reported, so "not in Discord yet" can list Initiates.
  guildRankName String?
  guildRankAt   DateTime?
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, nameKey])
}

model CharacterPairing {
  id         String    @id @default(cuid())
  guildId    String
  memberId   String
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  guild      Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([guildId, memberId])
  @@index([expiresAt])
}

// /guilded verify (7.3): one code per member, pasted once in game. Every character on that WoW
// account then repeats it in the guild digest, and an officer's upload links it to the member.
// Kept readable (not hashed): guildmates' addons see it anyway, and /character pair shows it again.
model CharacterVerifyCode {
  id        String   @id @default(cuid())
  guildId   String
  memberId  String
  code      String   @unique
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([guildId, memberId])
}

// What a member's code already did for one character: LINKED (told them by DM), TAKEN (linked to
// someone else; told once) or BLOCKED (unlinked since: the code never links it again).
model CharacterVerifyClaim {
  id        String   @id @default(cuid())
  guildId   String
  memberId  String
  nameKey   String
  status    String
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([guildId, memberId, nameKey])
}

model CompanionCredential {
  deviceName String @default("Paired companion")
  id        String    @id @default(cuid())
  memberId  String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  /// When this device last synced (at most every few minutes); shown as "Last synced" on /me/.
  lastUsedAt DateTime?
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, revokedAt])
}

// Weekly dungeon/PvP teams deliberately have no loot or point-pool relations.
model ActivityCore {
  battlegroundPlan Json?
  id              String @id @default(cuid())
  guildId         String
  name            String
  nameKey         String
  kind            String
  goal            String?
  channelId       String
  rosterMessageId String?
  weeklySchedule  String?
  timezone        String
  durationMinutes Int @default(120)
  tanks           Int
  healers         Int
  dps             Int
  archived        Boolean @default(false)
  createdAt       DateTime @default(now())
  guild           Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members         ActivityCoreMember[]
  sessions        ActivitySession[]

  @@unique([guildId, nameKey])
  @@index([guildId, archived])
}

model ActivityCoreMember {
  coreId      String
  memberId    String
  characterId String?
  role        RaidRole
  bench       Boolean @default(false)
  core        ActivityCore @relation(fields: [coreId], references: [id], onDelete: Cascade)
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@id([coreId, memberId])
}

model ActivitySession {
  id              String @id @default(cuid())
  coreId          String
  occurrence      String
  scheduledAt     DateTime
  endsAt          DateTime
  status          RaidStatus @default(PLANNED)
  openRecruitment Boolean @default(false)
  messageId       String?
  reminderQueued  Boolean @default(false)
  result          String?
  createdAt       DateTime @default(now())
  core            ActivityCore @relation(fields: [coreId], references: [id], onDelete: Cascade)
  responses       ActivityResponse[]

  @@unique([coreId, occurrence])
  @@index([status, scheduledAt])
}

model ActivityResponse {
  sessionId   String
  memberId    String
  characterId String?
  role        RaidRole
  status      String
  attendance  RaidAttendanceStatus?
  lineupOverride String?
  respondedAt DateTime @default(now())
  session     ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@id([sessionId, memberId])
  @@index([memberId, status])
}

// 7.0 website accounts: "Sign in with Discord" (identify scope only) on guilded.kcaron.top. Only the
// Discord user ID and names are kept, never the OAuth access token.
model BattleNetIdentity {
  id         String @id @default(cuid())
  accountId  String @unique
  subject    String @unique
  battleTag  String
  linkedAt   DateTime @default(now())
  account    WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  characters BattleNetCharacter[]
}

// Only explicitly selected characters are retained. Discovery never publishes alts.
model BattleNetCharacter {
  id          String @id @default(cuid())
  identityId  String
  region      String
  gameEdition String
  realmId     Int
  characterId Int
  name        String
  realm       String
  isMain      Boolean @default(false)
  verifiedAt  DateTime
  identity    BattleNetIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([region, gameEdition, realmId, characterId])
  @@index([identityId])
}

model WebAccount {
  battleNet BattleNetIdentity?
  publicProfile Boolean @default(true)
  characters    WebCharacter[]
  id            String   @id @default(cuid())
  discordUserId String   @unique
  username      String
  displayName   String?
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  sessions      WebSession[]
  applications  RecruitmentApplication[]
  cards         PlayerCard[]
  reports       RecruitmentReport[]
  pairing       WebPairing?
  companionCredentials WebCompanionCredential[]
}

// Only the uploader's own character is linked, never every member of the uploaded party.
model WebCharacter {
  gameEdition String @default("forever")
  id        String @id @default(cuid())
  accountId String
  name      String
  displayName String?
  realm     String
  account   WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, gameEdition, name, realm])
}

// One signed-in browser. The cookie holds a random token; only its SHA-256 is stored here.
model WebSession {
  id        String     @id @default(cuid())
  accountId String
  tokenHash String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  account   WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

// A guild's (coreId empty) or one core's recruitment listing on /recruitment/. Officers edit it with
// /mod recruit. Listed only while open and while the server is approved (not Lite).
model RecruitmentListing {
  id        String    @id @default(cuid())
  guildId   String
  coreId    String?   @unique
  // "guild:<guildId>" or "core:<coreId>": one listing per guild and one per core.
  scopeKey  String    @unique
  open      Boolean   @default(false)
  // Class names (wow-data CLASSES) and TANK/HEALER/DPS; empty means any.
  classes   String[]  @default([])
  roles     String[]  @default([])
  // monday..sunday
  raidDays  String[]  @default([])
  raidTimes String?
  // "en", "fr" or "both"
  language  String?
  // "ALLIANCE" or "HORDE"
  faction   String?
  realm     String?
  note      String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  core      RaidCore? @relation(fields: [coreId], references: [id], onDelete: Cascade)
  applications RecruitmentApplication[]

  @@index([open])
  @@index([guildId])
}

// A signed-in player's application from the website. Posted to the guild's applications (or
// officer log) channel with Accept / Decline / Spam buttons.
model RecruitmentApplication {
  id        String     @id @default(cuid())
  listingId String
  accountId String
  character String
  className String
  role      String
  message   String
  // PENDING, ACCEPTED, DECLINED or SPAM (SPAM also blocks new applications to this guild).
  status    String     @default("PENDING")
  channelId String?
  messageId String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime   @default(now())
  listing   RecruitmentListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  account   WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([listingId, status])
}

// "Looking for guild": one card per signed-in player, shown on /recruitment/ until it expires.
model PlayerCard {
  id          String     @id @default(cuid())
  accountId   String
  gameEdition String     @default("forever")
  character   String
  className   String
  role        String
  level       Int?
  realm       String?
  faction     String?
  language    String?
  raidDays    String[]   @default([])
  note        String?
  // Show the player's Discord username so guilds can contact them.
  showDiscord Boolean    @default(false)
  // Hidden after enough reports; the owner can clear it.
  hidden      Boolean    @default(false)
  expiresAt   DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  account     WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([hidden, expiresAt])
  @@unique([accountId, gameEdition])
}

// A signed-in visitor's report of a listing or a player card. One per visitor and target.
model RecruitmentReport {
  id         String     @id @default(cuid())
  accountId  String
  // "listing" or "card"
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime   @default(now())
  account    WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, targetType, targetId])
  @@index([targetType, targetId])
}

// A personal companion code from guilded.kcaron.top/me/ (7.0): pairs the companion with a
// website account instead of a guild member. 15 minutes, one use.
model WebPairing {
  id         String     @id @default(cuid())
  accountId  String     @unique
  codeHash   String     @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  account    WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// A personal companion's credential (one active per account). Only its SHA-256 is stored.
model WebCompanionCredential {
  deviceName String @default("Paired companion")
  id        String     @id @default(cuid())
  accountId String
  tokenHash String     @unique
  createdAt DateTime   @default(now())
  revokedAt DateTime?
  /// When this device last synced (at most every few minutes); shown as "Last synced" on /me/.
  lastUsedAt DateTime?
  account   WebAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
}

// One dungeon run on the public leaderboards (7.0, roadmap request 6). Party members share the
// addon's run id, so their uploads land on the same row and confirm each other.
model PublicRun {
  gameEdition String @default("forever")
  id            String   @id @default(cuid())
  // instanceId + the addon's shared run id.
  runKey        String   @unique
  runRef        String
  instanceId    Int
  dungeonName   String
  difficultyId  Int      @default(0)
  startedAt     DateTime
  endedAt       DateTime
  durationSec   Int
  deaths        Int?
  // Highest party level and its bracket (DEFAULT_DUNGEON_BRACKETS), when known.
  maxLevel      Int?
  bracket       String?
  // Calendar quarter of the end time, e.g. "2026-Q4" (legacy; pages use the monthly seasons).
  season        String
  // Rated route: the map id, or "189:<wing>" for Scarlet Monastery (public-score.ts).
  routeKey      String?
  // ACCEPTED (shown) or DISPUTED (uploads disagree: hidden until the owner looks).
  status        String   @default("ACCEPTED")
  // Different uploaders (players or guilds) whose upload agreed with this run.
  confirmations Int      @default(1)
  // "personal" or "guild"
  source        String
  // 1: completion method and boss kills recorded (7.4); 0: uploaded before, checked the old way.
  evidenceVersion Int    @default(0)
  // Additive current-v2 observation, never inferred from legacy online presence.
  integrity     Json?
  evidenceReceivedAt DateTime?
  challenge     Json?
  completedBy   String?
  // Successful boss kills inside the run: { id, name?, at?, startedAt? }[].
  encounters    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  players       PublicRunPlayer[]
  uploads       PublicRunUpload[]

  @@index([instanceId, status, season, durationSec])
  @@index([status, endedAt])
  @@index([gameEdition, status, endedAt])
}

model PublicRunPlayer {
  id        String    @id @default(cuid())
  runId     String
  character String
  displayName String?
  realm     String    @default("")
  className String?
  role      String?
  level     Int?
  // Level when the run started and seconds inside it (evidence, 7.4); null on older rows.
  minLevel   Int?
  presentSec Int?
  deaths    Int?
  run       PublicRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, character, realm])
  @@index([character, realm])
}

// Who sent a public run: "account:<id>" or "guild:<guildId>". One row per uploader and run.
model PublicRunUpload {
  id          String    @id @default(cuid())
  runId       String
  uploaderKey String
  durationSec Int
  endedAt     DateTime
  // Characters (lowercase) whose report this upload carries: one upload adds a confirmation only
  // when none of them was already counted (a guild's copy and a member's own upload are one report).
  reporters   String[]  @default([])
  // Individual observation retained for review; never sum overlapping presence.
  evidence    Json?
  historyOnly Boolean   @default(false)
  createdAt   DateTime  @default(now())
  run         PublicRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, uploaderKey])
  @@index([uploaderKey, createdAt])
}

// Owner-managed catalogue. A new schedule revision invalidates all pending reminders.
model OfficialGameEvent {
  id String @id
  game String
  region String @default("GLOBAL")
  titleEn String
  titleFr String
  dateLabelEn String @default("")
  dateLabelFr String @default("")
  sourceUrl String
  state String @default("TBA")
  startsAt DateTime? @db.Timestamptz(3)
  scheduleVersion Int @default(1)
  archived Boolean @default(false)
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// No row is created by setup or migration: publication is explicitly opt-in.
model GameEventBoard {
  editionReminders Json @default("{}")
  id String @id @default(cuid())
  guildId String
  channelId String
  enabled Boolean @default(false)
  games String[]
  region String
  messageId String?
  contentHash String?
  wowRoleId String?
  poeRoleId String?
  wowReminders Int[] @default([])
  poeReminders Int[] @default([])
  wowRemindersEnabledAt DateTime? @db.Timestamptz(3)
  poeRemindersEnabledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@unique([guildId, channelId])
}

// Explicit, short-lived self-report; never imported from peer addon observations.
model WebAvailability {
  memberId String @id
  characterId String
  guildId String
  gameEdition String
  role String
  expiresAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@index([guildId, gameEdition, expiresAt])
  @@index([expiresAt])
}

// Cosmetic achievements: no roles, points or loot advantage. Null earnedAt means
// historical evidence exists but the old display never recorded an award date.
model CommunityBadgeConfig {
  seasonId String @id
  enabled Boolean @default(false)
  channelId String
  baselineAt DateTime @default(now())
  season CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}
model CommunityBadge {
  id String @id @default(cuid())
  seasonId String
  userId String
  code String
  earnedAt DateTime?
  recordedAt DateTime @default(now())
  source String
  evidenceRef String?
  // SILENT/PENDING/ATTEMPTED/SENT/UNCERTAIN/CANCELLED. Never requeue ATTEMPTED:
  // a process crash may have happened after Discord accepted the message.
  delivery String @default("SILENT")
  nextAttemptAt DateTime @default(now())
  attemptedAt DateTime?
  messageId String?
  season CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  @@unique([seasonId, userId, code])
  @@index([delivery, nextAttemptAt])
}
model CommunityBadgeSharing {
  seasonId String
  userId String
  shared Boolean @default(true)
  season CommunitySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  @@id([seasonId, userId])
}

// Cosmetic, read-only progress. Frozen scope/rules; no point ledger relation.
model CooperativeGoal {
  guildId String @id
  seasonId String
  edition String
  seasonStartsAt DateTime
  seasonEndsAt DateTime?
  target Int
  metric String
  startsAt DateTime
  endsAt DateTime
  rules Json
  rulesHash String
  paused Boolean @default(false)
  createdBy String
  updatedAt DateTime @updatedAt
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// ATTEMPTED/UNCERTAIN is never retried automatically: Discord may have accepted.
model TargetedAlertAttempt {
  id String @id @default(cuid())
  guildId String
  memberId String
  eventKey String
  channelId String
  status String @default("ATTEMPTED")
  attemptedAt DateTime @default(now())
  messageId String?
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([guildId, memberId, eventKey])
  @@index([guildId, memberId, attemptedAt])
}

model WeeklyQuestionPlan {
  automation Json?
  guildId String @id
  settings Json
  revision Int @default(1)
  paused Boolean @default(false)
  createdBy String
  updatedAt DateTime @updatedAt
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model RecurringRecap {
  memberId String @id
  guildId String
  settings Json
  enabled Boolean @default(false)
  revision Int @default(1)
  lastPeriod String?
  lastAttemptAt DateTime?
  status String @default("OFF")
  messageId String?
  updatedAt DateTime @updatedAt
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@index([enabled, guildId])
}

model WeeklyQuestionReview {
  id String @id @default(cuid())
  guildId String
  actorId String
  revision Int
  weekKey String
  expiresAt DateTime
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@index([guildId, expiresAt])
}

model WeeklyQuestionOccurrence {
  id String @id @default(cuid())
  guildId String
  weekKey String
  status String
  pollId String?
  channelId String
  messageId String?
  createdAt DateTime @default(now())
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@unique([guildId, weekKey])
}

model BattlegroundConsent {
  memberId String @id
  guildId String
  capture Boolean @default(true)
  guildStats Boolean @default(true)
  consentedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@index([guildId, guildStats])
}

model BattlegroundReport {
  id String @id @default(cuid())
  guildId String
  memberId String
  characterId String
  reportId String
  adapter String
  gameEdition String
  mode String
  mapId Int
  bracket String
  endedAt DateTime
  durationSeconds Int
  outcome String
  presence String
  reloaded Boolean
  premadeNonce String?
  corroborated Boolean @default(false)
  fingerprint String
  status String @default("PROVISIONAL")
  correctionReason String?
  correctedAt DateTime?
  conflictFingerprint String?
  conflictSummary String?
  createdAt DateTime @default(now())
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([guildId, memberId, reportId])
  @@index([guildId, gameEdition, endedAt])
  @@index([memberId, endedAt])
  @@index([guildId, premadeNonce])
}

// Achievements (catalogue in src/services/achievements-catalogue.ts). One row per member per key, written
// the first time the recorded data reaches the threshold; earnedAt is the date that data says (or the
// detection time when the source keeps no history). Permanent, no points, no automatic announcement.
// Running Discord activity totals per member, for the message, voice and reaction achievements. Numbers only:
// message text is never read or stored. Counting starts when the bot first records a guild with achievements on.
model MemberActivityTotal {
  guildId           String
  userId            String
  messages          Int      @default(0)
  reactionsGiven    Int      @default(0)
  reactionsReceived Int      @default(0)
  voiceSeconds      Int      @default(0)
  since             DateTime @default(now())
  updatedAt         DateTime @updatedAt
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

model MemberAchievement {
  id         String   @id @default(cuid())
  guildId    String
  memberId   String
  key        String
  earnedAt   DateTime
  recordedAt DateTime @default(now())
  // The measured value when it was recorded (a level, a count).
  value      Int
  // When it was announced (or silently marked as announced). Null = waiting for the next announcement pass.
  announcedAt DateTime?
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([guildId, memberId, key])
  @@index([memberId])
  @@index([guildId, announcedAt])
}

// A Path of Exile 2 character level the member's own client log reported ("is now level N").
// One row per character, league and level, so uploads can repeat safely.
model PoeLevelReached {
  id        String   @id @default(cuid())
  guildId   String
  memberId  String
  character String
  league    String
  level     Int
  reachedAt DateTime
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([guildId, memberId, character, league, level])
  @@index([memberId, level])
}

// Cross-guild PUG board (opt-in): a guild joins explicitly; nothing is created or posted before that.
model PugBoardGuild {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String
  joinedBy  String
  joinedAt  DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// A guild hides another guild's requests (and its own requests are not shown there).
model PugBlock {
  id             String   @id @default(cuid())
  guildId        String
  blockedGuildId String
  createdAt      DateTime @default(now())
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, blockedGuildId])
}

// One request per raid while OPEN (a partial unique index in the migration enforces it).
// raidId is deliberately not a relation: deleting a raid must leave the row for the sweep to retire its posts.
model PugRequest {
  id              String      @id @default(cuid())
  raidId          String
  guildId         String
  edition         String
  raidTitle       String
  scheduledAt     DateTime
  wantTank        Int         @default(0)
  wantHealer      Int         @default(0)
  wantDps         Int         @default(0)
  note            String?
  status          String      @default("OPEN")
  closeReason     String?
  createdBy       String
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  closedAt        DateTime?
  noticeChannelId String?
  noticeMessageId String?
  guild           Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  posts           PugPost[]
  signups         PugSignup[]

  @@index([status, expiresAt])
  @@index([guildId, createdAt])
  @@index([raidId, status])
}

// The one message a participating guild shows for a request, edited in place.
model PugPost {
  id        String     @id @default(cuid())
  requestId String
  guildId   String
  channelId String
  messageId String?
  removedAt DateTime?
  createdAt DateTime   @default(now())
  request   PugRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, guildId])
  @@index([removedAt])
}

// discordUserId only deduplicates and is never shown; others see display name, character, class, role and note.
model PugSignup {
  id             String     @id @default(cuid())
  requestId      String
  discordUserId  String
  displayName    String
  sourceGuild    String?
  characterName  String
  characterClass String?
  role           String
  note           String?
  status         String     @default("PENDING")
  createdAt      DateTime   @default(now())
  decidedAt      DateTime?
  request        PugRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, discordUserId])
  @@index([requestId, status])
}

// The bot owner's private console in the home server (docs/OWNER_CONSOLE.md): one row, id "main".
model OwnerConsole {
  id             String    @id @default("main")
  channelId      String?
  boardMessageId String?
  // Opt-in daily digest (new/removed servers, error spikes). Off by default.
  digestEnabled  Boolean   @default(false)
  digestLastAt   DateTime?
  // { [discordGuildId]: name } as of the last digest, so the next one can say what changed.
  knownGuilds    Json?
  updatedAt      DateTime  @updatedAt
}

// Every owner console action (who, what, which server). Never holds message text or secrets.
model OwnerConsoleAudit {
  id             String   @id @default(cuid())
  actorId        String
  action         String
  targetGuildId  String?
  detail         String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// An officer-chosen link from a WoW guild rank (0 = guild master) to a Discord role.
model GuildRankRole {
  id            String   @id @default(cuid())
  guildId       String
  rankIndex     Int
  discordRoleId String
  createdBy     String
  createdAt     DateTime @default(now())
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, rankIndex])
}

// Discord-only item previews (docs/ITEM_PREVIEWS.md). Off unless an owner enables it for a server; the
// webhook URL is stored only as AES-256-GCM ciphertext.
model ItemPreviewConfig {
  id             String   @id @default(cuid())
  discordGuildId String   @unique
  channelId      String
  webhookId      String
  webhookSealed  String
  enabled        Boolean  @default(true)
  disabledReason String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Guild duels (8.4.5): one row per finished duel between two members of the same guild, reported by a paired
// participant's own client. Both players' companions report the same duel, so a row is matched by pair and time
// (within two minutes) before it is stored. `counted` is false once a pair has used its daily allowance
// (anti-farming); the row is kept so a replay cannot count it later.
model DuelResult {
  id             String   @id @default(cuid())
  guildId        String
  gameEdition    String   @default("forever")
  winnerId       String
  loserId        String
  winnerCharacter String
  loserCharacter String
  winnerLevel    Int?
  loserLevel     Int?
  reason         String   @default("knockout")
  endedAt        DateTime
  dayKey         String
  pairKey        String
  counted        Boolean  @default(true)
  reportKey      String
  reporterId     String?
  createdAt      DateTime @default(now())
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  winner         Member   @relation("DuelWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  loser          Member   @relation("DuelLoser", fields: [loserId], references: [id], onDelete: Cascade)

  @@unique([guildId, reportKey])
  @@index([guildId, gameEdition, counted, endedAt])
  @@index([guildId, pairKey, dayKey])
  @@index([winnerId])
  @@index([loserId])
}

// Personal milestones the member's own addon recorded (level steps, first dungeon clears, honorable kills,
// duel wins). Numbers and dates only. Feeds the achievements; posting to Discord stays the guild's own
// opt-in (/config achievements), never automatic.
model MemberMilestone {
  id          String   @id @default(cuid())
  guildId     String
  memberId    String
  gameEdition String   @default("forever")
  kind        String
  ref         String
  value       Int
  reachedAt   DateTime
  recordedAt  DateTime @default(now())
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([guildId, memberId, gameEdition, ref])
  @@index([guildId, memberId, kind])
}

// 8.5 track C: what the nickname sync changed, so a member's opt-out (or the officer turning it off) can restore
// the nickname they had. originalNickname null means they had none (the Discord name shows).
model MemberNickname {
  id               String   @id @default(cuid())
  guildId          String
  discordUserId    String
  originalNickname String?
  appliedNickname  String?
  optedOut         Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordUserId])
}

// 8.5 track B: "Race to 60" board. One row per guild character (linked or not) remembering when it was first seen at the
// level cap and its level at the start of the current week. Numbers only; hidden members are skipped when drawing.
model LevelRaceEntry {
  id             String    @id @default(cuid())
  guildId        String
  nameKey        String
  name           String
  className      String
  level          Int
  reachedMaxAt   DateTime?
  weekStartLevel Int
  weekStartedAt  DateTime
  // 9.1 daily recap: the level at the start of the server's day, and the last finished day's gain (kept across the rollover).
  dayStartLevel    Int?
  dayStartedAt     DateTime?
  lastDayGain      Int       @default(0)
  lastDayStartedAt DateTime?
  firstSeenAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  guild          Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, nameKey])
}

// 8.5 track B1: the Hall of Fame. One permanent row per character that reached 60, numbered in arrival order, so the history
// survives channel resets and re-syncs. `posted` is false until its message is sent; backfilled rows were found on the first run.
model RaceHallEntry {
  id              String   @id @default(cuid())
  guildId         String
  nameKey         String
  order           Int
  name            String
  className       String
  race            String?
  reachedAt       DateTime
  firstSeenAt     DateTime
  professions     String?
  memberDiscordId String?
  backfilled      Boolean  @default(false)
  posted          Boolean  @default(false)
  messageId       String?
  // 9.1: an officer removed it (kept as a tombstone so the refresh does not add the character again); the time to 60 since launch is trustworthy.
  removed          Boolean  @default(false)
  sinceLaunchKnown Boolean  @default(false)
  createdAt       DateTime @default(now())
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, nameKey])
  @@unique([guildId, order])
}

// 8.5 track C5: when a character's current guild rank was first seen (first link counts as the start), so
// "Initiate for 7+ days" can be computed. A changed rank name resets it.
model CharacterRankSeen {
  id          String    @id @default(cuid())
  characterId String    @unique
  rankName    String
  since       DateTime
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// 8.5 track G: one row per guild per UTC day (services/stat-snapshots.ts). Charts and the CSV feed read these.
model GuildStatSnapshot {
  id             String   @id @default(cuid())
  guildId        String
  // UTC day, YYYY-MM-DD.
  day            String
  discordMembers Int      @default(0)
  // Members whose message or voice totals changed in the 24 hours before the snapshot.
  activeMembers  Int      @default(0)
  // Active members with at least one linked character.
  linkedMembers  Int      @default(0)
  rosterSize     Int      @default(0)
  // Characters seen online in the 24 hours before the snapshot (highest value of the day).
  onlinePeak     Int      @default(0)
  level60        Int      @default(0)
  messages       Int      @default(0)
  voiceMinutes   Int      @default(0)
  raids          Int      @default(0)
  dungeonRuns    Int      @default(0)
  // Running totals, so the next day's messages and voice minutes are differences.
  totalMessages  Int      @default(0)
  totalVoiceSeconds Int   @default(0)
  levelBands     Json     @default("{}")
  classCounts    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, day])
}

// 8.5 batch 3 (#14): a player's post in the guild-invite channel. Officers see PENDING rows in /officer invites and in the
// addon's To invite panel; a roster upload that contains the character, or an officer's check mark, makes it INVITED.
model InviteRequest {
  id            String    @id @default(cuid())
  guildId       String
  // Lowercase "first last" (Forever names have both).
  nameKey       String
  displayName   String
  discordUserId String
  channelId     String
  messageId     String
  // PENDING (asked) -> INVITED -> JOINED -> PROMOTED. Officers move it on with /mod invites record.
  status        String    @default("PENDING")
  // Where the request came from: "discord" (the invite channel) or "website".
  source        String    @default("discord")
  // Officer-only note, and the applicant's answers to the interview questions.
  note          String?
  answers       String?
  // "roster" (seen in a guild roster upload), or the Discord ID of the officer who reacted.
  invitedBy     String?
  createdAt     DateTime  @default(now())
  invitedAt     DateTime?
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, messageId])
  @@index([guildId, status])
}

// 8.5 batch 3 (#13): the WoW-role DM was sent to this member in this server; never sent twice.
model InviteDm {
  guildId       String
  discordUserId String
  sentAt        DateTime @default(now())

  @@id([guildId, discordUserId])
}

// 8.5 guild data (docs/GUILD_DATA_INVENTORY.md): what the game's guild roster, event log and info
// panel show every member, uploaded by any member's companion. Guild-wide, latest snapshot wins.
model GuildRosterEntry {
  id           String    @id @default(cuid())
  guildId      String
  gameEdition  String    @default("forever")
  // characterKey(name): lowercase "first last" on Forever.
  nameKey      String
  name         String
  level        Int?
  className    String?
  rankName     String?
  rankIndex    Int?
  lastOnlineAt DateTime?
  inGuild      Boolean   @default(true)
  // When the uploader's game read this row, and whose companion brought it (Member id).
  observedAt   DateTime
  reportedById String?
  updatedAt    DateTime  @updatedAt

  @@unique([guildId, gameEdition, nameKey])
  @@index([guildId, inGuild])
}

// The game's guild event log (invites, joins, promotions, demotions, removals, quits). The game
// gives ages in hours, so the same event read by two members can differ by an hour or two: an
// event with the same kind, names and rank within 3 hours of a stored one is the same event.
model GuildEventEntry {
  id           String   @id @default(cuid())
  guildId      String
  gameEdition  String   @default("forever")
  kind         String
  actor        String
  target       String?
  rank         String?
  at           DateTime
  reportedById String?
  createdAt    DateTime @default(now())

  @@index([guildId, at])
  @@index([guildId, kind, actor])
}

// The guild's message of the day and information text, as last read in game.
model GuildText {
  guildId      String   @id
  motd         String?
  info         String?
  observedAt   DateTime
  reportedById String?
  updatedAt    DateTime @updatedAt
}

// 9.0 guild bank ledger (docs/GUILD_BANK_LEDGER.md): what any member's companion uploads after
// someone with access opened the guild bank. Read-only in Discord and on the website.
model GuildBankContents {
  guildId      String   @id
  observedAt   DateTime
  // Copper.
  money        BigInt?
  // [{ tab, name, items: [{ id, name, count }] }]
  tabs         Json
  reportedById String?
  updatedAt    DateTime @updatedAt
}

// One gold reading per bank visit, for the gold history chart.
model GuildBankGold {
  id      String   @id @default(cuid())
  guildId String
  at      DateTime
  money   BigInt

  @@unique([guildId, at])
}

// The game's guild bank logs. The game gives ages in hours, so the same line read by two members
// within 3 hours is the same line (services/guild-bank.ts).
model GuildBankTransaction {
  id           String   @id @default(cuid())
  guildId      String
  // "item" or "money"
  kind         String
  // The game's word: deposit, withdraw, move, repair, buyTab, ...
  type         String
  actor        String
  itemId       Int?
  itemName     String?
  count        Int?
  tab          Int?
  tab2         Int?
  amount       BigInt?
  at           DateTime
  reportedById String?
  createdAt    DateTime @default(now())

  @@index([guildId, at])
}

// 9.1 minimum stock (docs/plans/GUILD_BANK.md): officers keep at least `minCount` of an item in
// the bank. `lowSince` is set when an upload shows less (one alert), cleared when it is back.
model GuildBankTarget {
  id        String    @id @default(cuid())
  guildId   String
  itemId    Int
  itemName  String
  minCount  Int
  lowSince  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([guildId, itemId])
}

// 9.0: which linked characters the "you're linked" DM already told a member about (companion-link-dm.ts).
model MemberLinkNotice {
  memberId    String   @id
  characterIds String  @default("")
  notifiedAt  DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// 9.1 guild records and challenges (docs/plans/RECORDS_AND_RECAPS.md). One row per record or challenge; the unique key makes
// each one happen once (a re-upload or second observer never repeats it). `kind`: clear, boss, first, deathless, guild5.
model DungeonHighlight {
  id           String     @id @default(cuid())
  guildId      String
  runId        String
  key          String
  kind         String
  instanceId   Int
  difficultyId Int
  dungeonName  String
  // Boss name for a boss record.
  label        String?
  valueSec     Int?
  previousSec  Int?
  players      String[]
  createdAt    DateTime   @default(now())
  guild        Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  run          DungeonRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
  @@index([guildId, createdAt])
  @@index([runId])
}

// Track M (phone guildmate map): where a member's own character was last seen outdoors, from their
// companion upload (addon GuildMap.lua). Guild-only, never public; deleted when the member turns
// sharing off and pruned after 28 days. zone x/y are 0..1 on the zone map; cx/cy on its continent.
model GuildMapSighting {
  id          String   @id @default(cuid())
  guildId     String
  memberId    String
  character   String
  mapId       Int
  zone        String
  x           Float
  y           Float
  continentId Int?
  continent   String?
  cx          Float?
  cy          Float?
  seenAt      DateTime
  createdAt   DateTime @default(now())
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, character, seenAt])
  @@index([guildId, seenAt])
}

// Track M: a call for help the member sent in game (addon CallForHelp.lua), uploaded by their own
// companion, shown as a pin on the phone map. Coordinates are kept only while the member shares.
model GuildHelpCall {
  id          String    @id @default(cuid())
  guildId     String
  memberId    String
  ref         String
  character   String
  zone        String
  subzone     String?
  mapId       Int?
  x           Float?
  y           Float?
  continentId Int?
  continent   String?
  cx          Float?
  cy          Float?
  attackers   Json
  calledAt    DateTime
  clearedAt   DateTime?
  createdAt   DateTime  @default(now())
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, ref])
  @@index([guildId, calledAt])
}

// Daily rank snapshot of one leaderboard (race, dungeon season, duels, a battleground bracket), one row per board per UTC day,
// rewritten on every refresh that day. `ranks` maps a character or member id to its rank. The ladder cards compare today's ranks
// with the latest earlier day to draw "since yesterday" arrows. Rows older than 14 days are pruned on write.
model LadderSnapshot {
  id        String   @id @default(cuid())
  guildId   String
  board     String
  day       String
  ranks     Json
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, board, day])
}

// Traced dungeon maps (9.2): one shared, anonymous occupancy grid per dungeon floor (uiMapID), merged from members' walked
// grid cells on import. `cells` maps a cell key (column * 200 + row) to how many runs walked it; no player, run or time is kept,
// and the per-run cells are dropped once merged. The dungeon card draws the floor's outline from it (dungeon-map-grid.ts).
model DungeonMapGrid {
  mapId       Int      @id
  dungeonName String
  cells       Json
  runs        Int      @default(0)
  updatedAt   DateTime @updatedAt
}
