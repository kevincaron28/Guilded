{
  "name": "guilded-companion",
  "productName": "Guilded Companion",
  "version": "5.0.0",
  "description": "Sends your Guilded addon data to the Discord bot and keeps in-game standings fresh.",
  "main": "main.cjs",
  "private": true,
  "author": "Guilded",
  "scripts": {
    "start": "npm run icon && electron .",
    "icon": "node make-icon.mjs",
    "dist": "npm run icon && electron-builder --win nsis --publish never",
    "pack": "npm run icon && electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.guilded.companion",
    "productName": "Guilded Companion",
    "directories": {
      "output": "../dist/companion"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "detect-wow.cjs",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../companion",
        "to": "engine",
        "filter": [
          "engine.mjs",
          "lua-export.mjs",
          "standings.mjs",
          "request.mjs"
        ]
      },
      {
        "from": "node_modules/luaparse",
        "to": "engine/node_modules/luaparse",
        "filter": [
          "package.json",
          "luaparse.js"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Guilded Companion",
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "luaparse": "^0.3.1"
  }
}
