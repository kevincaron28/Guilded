NODE_ENV=development
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Paste your own PostgreSQL connection string, including provider-required SSL options.
DATABASE_URL=
# Optional, recommended with a pooled DATABASE_URL (Neon "-pooler" host): the direct (non-pooled)
# connection string, used only for database updates (prisma migrate).
DIRECT_URL=
COMPANION_API_PORT=8787
# 127.0.0.1 = this computer only (also right behind Caddy on a server, see docs/DEPLOY_ORACLE.md)
COMPANION_API_HOST=127.0.0.1
# Public online companion address shown in Discord, e.g. https://your-bot.example/companion/
# The official hosted bot uses its own companion automatically. Independent hosts set this.
COMPANION_WEB_URL=
# Companions pair with /character pair. No shared upload token is needed.
# Optional (7.0): website sign-in with Discord for /recruitment/ and the public leaderboards.
# Secret: Developer Portal > your app > OAuth2 > Client Secret. Add the redirect
# <PUBLIC_SITE_URL>/auth/callback there. WEB_SESSION_SECRET: 32+ random characters.
DISCORD_OAUTH_CLIENT_SECRET=
PUBLIC_SITE_URL=
WEB_SESSION_SECRET=
# Optional: Warcraft Logs API client (https://www.warcraftlogs.com/api/clients) for /wcl
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
LOG_LEVEL=info
# Optional: a channel ID (in any guild the bot is in) that gets a live feed of
# captured errors and /report bug submissions. Leave blank to only save them
# to the database.
ERROR_LOG_CHANNEL_ID=
# 5.0 answer channel (/mod faq). Turn on "Message Content Intent" for the bot in the Discord
# Developer Portal (Bot page) FIRST, then set this to true. Without it the answer channel stays off.
MESSAGE_CONTENT_INTENT=false
# Once a day, tell officers (officer log channel) when a newer Guilded release is out. false = off.
UPDATE_CHECK=true
# Optional free AI answers when no officer answer matches (leave blank for officer answers only).
# Google AI Studio: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-3.8-flash
# Groq:            AI_BASE_URL=https://api.groq.com/openai/v1                          AI_MODEL=llama-3.1-8b-instant
# Ollama on the server (no key): AI_BASE_URL=http://127.0.0.1:11434/v1                 AI_MODEL=llama3.2:3b
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=100

# Shared hosted pilot: only the primary DISCORD_GUILD_ID and these approved servers may use it.
# Owner CLI: npm run pilot -- enable / approve SERVER_ID / revoke SERVER_ID / status
HOSTED_PILOT=false
HOSTED_GUILD_IDS=
HOSTED_GUILD_LIMIT=5
# Servers waiting for approval get Guilded Lite, up to this many (0: no access until approved).
HOSTED_LITE_LIMIT=50
# Approve a set-up, active Lite server by itself after this many days (0: approvals stay manual).
HOSTED_AUTO_APPROVE_DAYS=0
HOSTED_AUTO_APPROVE_MEMBERS=5
# Total provider attempts across ALL servers per UTC day, including failed requests.
# AI stays disabled in each new guild until an officer opts in; normal FAQ stays available.
AI_GLOBAL_DAILY_LIMIT=100

# Optional owner-approved dungeon history reset boundary, e.g. 2026-10-23T18:00:00Z.
# Rejects older/missing run starts on both guild and personal uploads. Set only
# with a backed-up history reset; keep it during recovery to prevent re-imports.
DUNGEON_RUNS_NOT_BEFORE=
