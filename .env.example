NODE_ENV=development
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Paste your own PostgreSQL connection string, including provider-required SSL options.
DATABASE_URL=
# Optional, recommended with a pooled DATABASE_URL (Neon "-pooler" host): the direct (non-pooled)
# connection string, used only for database updates (prisma migrate).
DIRECT_URL=
COMPANION_API_PORT=8787
# 127.0.0.1 = this computer only (also right behind Caddy on a server, see docs/DEPLOY_ORACLE.md)
COMPANION_API_HOST=127.0.0.1
# Companions pair with /character pair. No shared upload token is needed.
# Optional: Warcraft Logs API client (https://www.warcraftlogs.com/api/clients) for /wcl
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
LOG_LEVEL=info
# Optional: a channel ID (in any guild the bot is in) that gets a live feed of
# captured errors and /report bug submissions. Leave blank to only save them
# to the database.
ERROR_LOG_CHANNEL_ID=
# 5.0 answer channel (/mod faq). Turn on "Message Content Intent" for the bot in the Discord
# Developer Portal (Bot page) FIRST, then set this to true. Without it the answer channel stays off.
MESSAGE_CONTENT_INTENT=false
# Optional free AI answers when no officer answer matches (leave blank for officer answers only).
# Google AI Studio: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-3.8-flash
# Groq:            AI_BASE_URL=https://api.groq.com/openai/v1                          AI_MODEL=llama-3.1-8b-instant
# Ollama on the server (no key): AI_BASE_URL=http://127.0.0.1:11434/v1                 AI_MODEL=llama3.2:3b
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=100
