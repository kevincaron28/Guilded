{
  "name": "guilded-companion",
  "productName": "Guilded Companion",
  "version": "8.4.0",
  "description": "Your guild, connected. World of Warcraft sync and Path of Exile 2 mapping.",
  "main": "main.cjs",
  "private": true,
  "author": "Guilded",
  "scripts": {
    "start": "npm run icon && electron .",
    "icon": "node make-icon.mjs",
    "dist": "npm --prefix .. run companion:build && electron-builder --win nsis --publish never",
    "pack": "npm --prefix .. run companion:build && electron-builder --win dir --publish never",
    "msix:preview": "npm --prefix .. run companion:build && node build-msix.cjs --preview",
    "msix:store": "npm --prefix .. run companion:build && node build-msix.cjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.guilded.companion",
    "productName": "Guilded Companion",
    "directories": {
      "output": "../dist/companion"
    },
    "files": [
      "main.cjs",
      "store-config.cjs",
      "preload.cjs",
      "grm-import.cjs",
      "loot-history-import.cjs",
      "detect-wow.cjs",
      "update-check.cjs",
      "i18n.cjs",
      "locales/**",
      "renderer/**",
      "assets/**",
      "package.json",
      "ipc-security.cjs",
      "sign-in-loopback.cjs"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.Guilded.txt"
      },
      {
        "from": "../companion",
        "to": "engine",
        "filter": [
          "engine.mjs",
          "grm-migration.mjs",
          "loot-history-import.mjs",
          "lua-export.mjs",
          "saved-file.mjs",
          "standings.mjs",
          "request.mjs",
          "poe-engine.mjs",
          "poe-log.mjs",
          "lua-export-content.mjs",
          "game-edition.mjs",
          "character-identity.mjs",
          "dungeon-role.mjs",
          "profiles.mjs",
          "profile-engine.mjs",
          "standings-format.mjs",
          "poe-events.mjs",
          "delta.mjs",
          "data-addon.mjs",
          "personal-runs.mjs",
          "personal-runs-content.mjs",
          "sheet-export.mjs",
          "live-folder.mjs",
          "revoke.mjs"
        ]
      },
      {
        "from": "node_modules/luaparse",
        "to": "engine/node_modules/luaparse",
        "filter": [
          "package.json",
          "luaparse.js"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Guilded Companion",
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "luaparse": "^0.3.1"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
