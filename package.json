{
  "name": "guilded-bot",
  "version": "8.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "description": "Guild management and addon integration bot for Guilded",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx src/main.ts",
    "start:local": "tsx src/main.ts",
    "companion:app": "npm --prefix companion-app start",
    "companion:watch": "node companion/watcher.mjs",
    "addon:zip": "node scripts/build-addon-zip.mjs",
    "addon:editions": "node scripts/build-addon-editions.mjs",
    "dungeons:sync": "node scripts/build-dungeons-addon.mjs",
    "dungeons:zip": "node scripts/build-dungeons-addon.mjs --zip",
    "locale": "node scripts/addon-locale.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:generate": "node scripts/with-env.mjs prisma generate",
    "prisma:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:update": "node scripts/with-env.mjs prisma migrate deploy && node scripts/with-env.mjs prisma generate",
    "companion:setup": "node scripts/setup-companion.mjs",
    "setup:check": "tsx scripts/check-setup.ts",
    "pilot": "tsx scripts/pilot.ts",
    "guild-page": "tsx scripts/guild-page.ts",
    "bugs": "tsx scripts/bugs.ts",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "node scripts/preview-site.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "release:ledger-check": "node scripts/with-env.mjs tsx scripts/ledger-preflight.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "companion:build": "node companion-app/make-icon.mjs && node scripts/build-companion-web.mjs",
    "worker:build": "npm run site:build && wrangler deploy --dry-run",
    "worker:deploy": "npm run site:build && wrangler deploy",
    "ledger:compact": "node companion/ledger-compact.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "discord.js": "^14.22.1",
    "dotenv": "^18.0.8",
    "entities": "^8.1.0",
    "luaparse": "^0.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fengari": "^0.1.5",
    "fflate": "^0.8.3",
    "marked": "^18.1.1",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "sharp": "^0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
